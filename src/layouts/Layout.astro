---
import "@fontsource/space-mono/400.css";
import "@fontsource/space-mono/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/red-hat-text/400.css"; // About paragraphs
import "@fontsource/red-hat-text/600.css";
import "@fontsource/red-hat-mono/300.css"; // About headings (home and project pages)
// Red Hat Text is preloaded, so the About text lays out in it from the first paint (a late swap from the
// fallback font reflowed the text and resized the clip card beside it). IBM Plex Mono too: a project's
// summary waits for it before it's sized and shown (scripts/fit-text.ts).
import redHat400 from "@fontsource/red-hat-text/files/red-hat-text-latin-400-normal.woff2?url";
import redHat600 from "@fontsource/red-hat-text/files/red-hat-text-latin-600-normal.woff2?url";
import plex400 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";
import "../styles/global.css";
import { site } from "../content/site";

interface Props {
	title?: string;
	description?: string;
}

// Defaults are the home page's: what shows in the browser tab, search results, and link previews
const {
	title = "Eli Rose · Software Engineering",
	description = "Eli Rose is a software engineer and Georgia Tech M.S. CS student who builds backend systems, data pipelines, and self-hosted infrastructure. Projects, resume, and contact.",
} = Astro.props;

// The link-preview image (rendered by scripts/render-art.py). Previews need an absolute URL,
// built from `site` in astro.config.mjs.
const ogImage = new URL("/preview-image.png", Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0b0e14" />
		<meta name="color-scheme" content="dark" />
		<link rel="preload" href={redHat400} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={redHat600} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={plex400} as="font" type="font/woff2" crossorigin />
		{/* Marks a page whose scripts will run, so content they size can wait hidden until it's sized */}
		<script is:inline>document.documentElement.classList.add("js");</script>
		{/* Bump ?v= when an icon changes: browsers cache them hard. favicon.ico stays at the root,
		    where browsers look for it without being told */}
		<link rel="icon" href="/favicon.ico?v=5" sizes="48x48" />
		<link rel="icon" href="/assets/favicon.svg?v=5" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png?v=5" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${site.name}: ${site.tagline}`} />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<slot />
	</body>
</html>
