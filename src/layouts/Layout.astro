---
import "@fontsource/space-mono/400.css";
import "@fontsource/space-mono/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/inter/400.css"; // About paragraphs
import "@fontsource/inter/500.css";
// Inter is preloaded, so the About text lays out in Inter from the first paint (a late swap from the fallback
// font reflowed the text and resized the clip card beside it)
import inter400 from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";
import inter500 from "@fontsource/inter/files/inter-latin-500-normal.woff2?url";
import "../styles/global.css";
import { site } from "../content/site";

interface Props {
	title?: string;
	description?: string;
}

// Defaults are the home page's: what shows in the browser tab, search results, and link previews
const {
	title = "Eli Rose · Robotics Software",
	description = "Eli Rose is an M.S. Computer Science student at Georgia Tech building robotics and embedded software. Projects, resume, and contact links.",
} = Astro.props;

// The link-preview image (rendered by scripts/render-art.py). Previews need an absolute URL,
// built from `site` in astro.config.mjs.
const ogImage = new URL("/preview-image.png", Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0b0e14" />
		<meta name="color-scheme" content="dark" />
		<link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={inter500} as="font" type="font/woff2" crossorigin />
		{/* Bump ?v= when an icon changes: browsers cache them hard. favicon.ico stays at the root,
		    where browsers look for it without being told */}
		<link rel="icon" href="/favicon.ico?v=5" sizes="48x48" />
		<link rel="icon" href="/assets/favicon.svg?v=5" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png?v=5" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${site.name}: ${site.tagline}`} />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<slot />
	</body>
</html>
