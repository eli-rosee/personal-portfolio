---
// A project's page, from its folder in src/content/projects/ (see src/content.config.ts)
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Starfield from "../../components/Starfield.astro";
import ProjectHero from "../../components/project/ProjectHero.astro";
import ProjectReadouts from "../../components/project/ProjectReadouts.astro";
import ProjectHook from "../../components/project/ProjectHook.astro";
import ProjectAbout from "../../components/project/ProjectAbout.astro";
import ProjectMedia from "../../components/project/ProjectMedia.astro";
import Theater, { type Pane } from "../../components/project/Theater.astro";
import NextProject from "../../components/project/NextProject.astro";
import { getProjects } from "../../scripts/projects";
import { plainText } from "../../scripts/markdown";
import { highlights, media, writeUp } from "../../scripts/project-files";

export async function getStaticPaths() {
	const projects = await getProjects();
	// The next project wraps around to the first
	return projects.map((project, i) => ({ params: { id: project.id }, props: { project, next: projects[(i + 1) % projects.length] } }));
}

const { project, next } = Astro.props;
const { title, summary, readouts, statement, achievement } = project.data;
const sections = await writeUp(project);
const items = media(project);
const { list: picks, screen } = highlights(project, sections, items);
// The theater holds only what Media shows: the highlights, in order (a highlight is a Media card or a
// write-up figure)
const figures = sections.flatMap((s) => s.blocks.flatMap((b) => (b.kind === "figures" ? b.figures : [])));
const panes: Pane[] = picks.flatMap((h): Pane[] => {
	const card = { id: h.id, group: "Media" as const, title: h.title };
	const it = items.find((i) => i.id === h.id);
	if (it?.type === "image") return [{ ...card, caption: it.caption, kind: "visual", asset: it.asset, alt: it.alt }];
	if (it?.type === "clip") return [{ ...card, caption: it.caption, kind: "visual", asset: it.asset }];
	if (it?.type === "video") return [{ ...card, caption: it.caption, kind: "video", asset: it.asset, poster: it.poster }];
	if (it?.type === "slides") return [{ ...card, caption: it.caption, kind: "slides", slides: it.slides, pdf: it.pdf }];
	const f = figures.find((f) => f.id === h.id);
	return f ? [{ ...card, kind: "visual", asset: f.asset, alt: f.alt }] : [];
});
---

<Layout title={`${title} · Eli Rose`} description={plainText(summary)}>
	<Starfield />
	<Nav />
	<main class="project">
		{/* A pointer up to the logo, the way back to the home page */}
		<p class="hint label">
			<svg viewBox="0 0 60 34" aria-hidden="true"><path class="dash" d="M54 26 H 20 Q 8 26, 8 14 V 6" pathLength="57" /><path d="M3.5 9.5 8 4 12.5 9.5" /></svg>
			<span>[ER] returns home</span>
		</p>
		<ProjectHero project={project} featured={screen} />
		<ProjectReadouts readouts={readouts} />
		<ProjectHook statement={statement} achievement={achievement} />
		<ProjectMedia highlights={picks} items={items} />
		<ProjectAbout sections={sections} />
		<NextProject next={next} />
		<Theater panes={panes} />
	</main>
	<Footer telemetry={false} />
</Layout>

<script>
	import { initTheater } from "../../scripts/theater";
	import { initPlayers } from "../../scripts/player";
	import { playClips } from "../../scripts/clips";
	import { initClipHuds } from "../../scripts/clip-hud";
	import { initFlight } from "../../scripts/flight";
	import { fitRow, fitText } from "../../scripts/fit-text";
	import { fitReadoutInset } from "../../scripts/readout-inset";

	// Sizing (the hero's buttons and summary, the readouts' inset) and wiring (everything interactive). After a flight the next
	// page is sized while it's still invisible ("project:prepare"), so it fades in at its final size, and
	// wired once it has replaced this one ("project:swap"). Each page's listeners and observers live as
	// long as the page: the swap ends the old one's, so a removed page can't linger in memory.
	const fit = (root: ParentNode, signal: AbortSignal) => {
		fitRow(root, signal);
		fitText(root, signal);
		fitReadoutInset(root, signal);
	};
	const wire = (root: ParentNode, signal: AbortSignal) => {
		initTheater(root, signal);
		initPlayers(root, signal);
		playClips(root, signal);
		initClipHuds(root, signal);
		initFlight(root, signal);
	};
	let page = new AbortController();
	let next = new AbortController();
	fit(document, page.signal);
	wire(document, page.signal);
	document.addEventListener("project:prepare", (e) => {
		next.abort(); // a page prepared before, never shown
		next = new AbortController();
		fit((e as CustomEvent<HTMLElement>).detail, next.signal);
	});
	document.addEventListener("project:swap", (e) => {
		page.abort();
		page = next;
		next = new AbortController();
		wire((e as CustomEvent<HTMLElement>).detail, page.signal);
	});
</script>

<style>
	.project {
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 2.5rem var(--gutter) 0;
	}

	.hint {
		display: flex;
		align-items: flex-end;
		gap: 0.45rem;
		margin: -1.4rem 0 1.75rem;
		font-size: 0.68rem;
		line-height: 1;
		user-select: none;
	}

	.hint svg {
		flex: none;
		width: 2.6rem;
		margin-left: calc(41px - 2.6rem * 8 / 60);
		margin-bottom: calc(0.34rem - 2.6rem * 8 / 60);
		overflow: visible;
		fill: none;
		stroke: var(--muted);
		stroke-width: 1.25;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.hint .dash {
		stroke-dasharray: 3 3;
	}

	/* The home page's gap between sections; Media joins the hook above it as content joins its heading */
	.project > :global(:is(.hook, .media, .about, .next)) {
		margin-top: var(--section-gap);
	}

	.project > :global(.hook + .media) {
		margin-top: var(--content-gap);
	}
</style>
