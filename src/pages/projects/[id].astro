---
// A project's page, from its folder in src/content/projects/ (see src/content.config.ts)
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Starfield from "../../components/Starfield.astro";
import ProjectHero from "../../components/project/ProjectHero.astro";
import ProjectReadouts from "../../components/project/ProjectReadouts.astro";
import ProjectAbout from "../../components/project/ProjectAbout.astro";
import ProjectMedia from "../../components/project/ProjectMedia.astro";
import Theater, { type Pane } from "../../components/project/Theater.astro";
import NextProject from "../../components/project/NextProject.astro";
import { getProjects } from "../../scripts/projects";
import { media, writeUp } from "../../scripts/project-files";

export async function getStaticPaths() {
	const projects = await getProjects();
	// The next project wraps around to the first
	return projects.map((project, i) => ({ params: { id: project.id }, props: { project, next: projects[(i + 1) % projects.length] } }));
}

const { project, next } = Astro.props;
const { title, summary, readouts, statement } = project.data;
const sections = await writeUp(project);
const items = media(project);
// The theater's items, in page order: the write-up's figures (About), then the Media cards
const panes: Pane[] = [
	...sections
		.flatMap((s) => s.blocks.flatMap((b) => (b.kind === "figures" ? b.figures : [])))
		.map((f): Pane => ({ id: f.id, group: "About", title: f.caption ?? f.alt, alt: f.alt, kind: "visual", asset: f.asset })),
	...items.flatMap((it): Pane[] => {
		const card = { id: it.id, group: "Media" as const, title: it.title, caption: it.caption };
		if (it.type === "image") return [{ ...card, kind: "visual", asset: it.asset, alt: it.alt }];
		if (it.type === "clip") return [{ ...card, kind: "visual", asset: it.asset }];
		if (it.type === "video") return [{ ...card, kind: "video", asset: it.asset, poster: it.poster }];
		if (it.type === "slides") return [{ ...card, kind: "slides", slides: it.slides, pdf: it.pdf }];
		return [];
	}),
];
---

<Layout title={`${title} · Eli Rose`} description={summary}>
	<Starfield />
	<Nav />
	<main class="project">
		{/* A pointer up to the logo, the way back to the home page */}
		<p class="hint label">
			<svg viewBox="0 0 60 34" aria-hidden="true"><path class="dash" d="M54 26 H 20 Q 8 26, 8 14 V 6" pathLength="57" /><path d="M3.5 9.5 8 4 12.5 9.5" /></svg>
			<span>[ER] returns home</span>
		</p>
		<ProjectHero project={project} />
		<ProjectReadouts readouts={readouts} />
		<ProjectAbout statement={statement} sections={sections} />
		<ProjectMedia items={items} />
		<NextProject next={next} />
		<Theater panes={panes} />
	</main>
	<Footer telemetry={false} />
</Layout>

<script>
	import { initTheater } from "../../scripts/theater";
	import { initPlayers } from "../../scripts/player";
	import { playClips } from "../../scripts/clips";
	import { initFlight } from "../../scripts/flight";
	import { fitRow, fitText } from "../../scripts/fit-text";

	// Sizing (the hero's buttons and summary) and wiring (everything interactive). After a flight the next
	// page is sized while it's still invisible ("project:prepare"), so it fades in at its final size, and
	// wired once it has replaced this one ("project:swap").
	const fit = (root: ParentNode) => {
		fitRow(root);
		fitText(root);
	};
	const wire = (root: ParentNode) => {
		initTheater(root);
		initPlayers(root);
		playClips(root);
		initFlight(root);
	};
	fit(document);
	wire(document);
	document.addEventListener("project:prepare", (e) => fit((e as CustomEvent<HTMLElement>).detail));
	document.addEventListener("project:swap", (e) => wire((e as CustomEvent<HTMLElement>).detail));
</script>

<style>
	.project {
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 2.5rem var(--gutter) 0;
	}

	.hint {
		display: flex;
		align-items: flex-end;
		gap: 0.45rem;
		margin: -1.4rem 0 1.75rem;
		font-size: 0.68rem;
		line-height: 1;
		user-select: none;
	}

	.hint svg {
		flex: none;
		width: 2.6rem;
		margin-left: calc(41px - 2.6rem * 8 / 60);
		margin-bottom: calc(0.34rem - 2.6rem * 8 / 60);
		overflow: visible;
		fill: none;
		stroke: var(--muted);
		stroke-width: 1.25;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.hint .dash {
		stroke-dasharray: 3 3;
	}

	.project > :global(:is(.about, .media)) {
		margin-top: 6rem;
	}
</style>
