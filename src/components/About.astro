---
/*
 * About: a one-line statement, then short paragraphs under small prompts (src/data/about.md),
 * with the climbing clip card beside them (below them on phones).
 *
 * Markdown conventions in about.md:
 *   statement: "... *phrase* ..."   the phrase is amber and launches the rocket on the clip card
 *   ### Prompt                      a small label over each paragraph
 *   **key phrase**                  set in the text color, above the muted body
 *   [text](#target "Tip")           a bracketed link with a tooltip
 */
import { getEntry } from "astro:content";
import { compiledContent, frontmatter } from "../data/about.md";
import SectionHeading from "./SectionHeading.astro";
import ClipCard from "./ClipCard.astro";

// The clip is optional; the section works without it
const clip = (await getEntry("clip", "clip"))?.data;

const escapeHtml = (text: string) =>
	text.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

// Punctuation right after the phrase stays on its line, next to the closing bracket
const statement: string | undefined = frontmatter.statement;
const statementHtml = statement
	? escapeHtml(statement).replace(
			/\*([^*]+)\*([.,!?;:]?)/g,
			'<span class="nowrap"><button type="button" class="launch" data-launch><em>$1</em><span class="tooltip label" aria-hidden="true">Launch the Rocket</span></button>$2</span>',
		)
	: undefined;

const proseHtml = (await compiledContent()).replace(
	/<a href="([^"]*)" title="([^"]*)">([^<]*)<\/a>/g,
	'<a href="$1">$3<span class="tooltip label" aria-hidden="true">$2</span></a>',
);
---

<section id="about" class="section" aria-labelledby="about-heading">
	<SectionHeading id="about-heading" text="About" />
	<div class:list={["layout", { "has-clip": clip }]}>
		{statementHtml && <p class="statement" set:html={statementHtml} />}
		<div class="prose" set:html={proseHtml} />
		{clip && <ClipCard clip={clip} />}
	</div>
</section>

<style>
	/* One rhythm: 2.5rem after the statement, 2rem between parts, 0.5rem from a prompt to its paragraph */
	.layout {
		display: grid;
		row-gap: var(--space-6);
	}

	.statement {
		max-width: 30rem; /* room for the brackets, so the statement stays on two lines */
		margin-bottom: calc(2.5rem - var(--space-6)); /* 2.5rem to the text, counting the row gap */
		font-family: var(--font-label);
		font-size: 1.35rem;
		line-height: 1.45;
		letter-spacing: -0.01em;
		color: var(--text);
	}

	.statement :global(em) {
		font-style: normal;
		color: var(--accent);
	}

	.prose {
		max-width: 29rem;
		font-family: "Inter", sans-serif;
		font-size: 1rem;
		line-height: 1.9;
		color: var(--muted);
	}

	/* Prompts: small bold labels, lighter than the body so they read as headings, but below the
	   white key phrases */
	.prose :global(h3) {
		margin: 2rem 0 0.5rem;
		font-family: var(--font-label);
		font-size: 0.72rem;
		font-weight: 700;
		line-height: 1.6;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: #b9bdc7;
	}

	.prose :global(h3:first-child) {
		margin-top: 0;
	}

	.prose :global(strong) {
		font-weight: 500;
		color: var(--text);
	}

	/* The launch phrase and the links: amber, framed in amber console brackets instead of an
	   underline, with a tooltip underneath */
	.statement :global(.launch) {
		all: unset;
		position: relative;
		cursor: pointer;
	}

	.statement :global(.launch:focus-visible) {
		outline: 2px solid var(--accent); /* `all: unset` drops the global focus ring */
		outline-offset: 3px;
	}

	.statement :global(.nowrap),
	.prose :global(a) {
		white-space: nowrap;
	}

	.prose :global(a) {
		position: relative;
		text-decoration: none;
	}

	.statement :global(.launch)::before,
	.prose :global(a)::before {
		content: "[";
		margin-right: 0.1em;
	}

	.statement :global(.launch)::after,
	.prose :global(a)::after {
		content: "]";
		margin-left: 0.1em;
	}

	.statement :global(.launch)::before,
	.statement :global(.launch)::after {
		color: var(--accent);
	}

	/*
	 * Desktop: text on the left, the card on the right. The statement spans four equal rows and the
	 * card starts on the fourth, so its top sits three quarters down the statement (no measuring: a
	 * spanning item's height is shared equally by 1fr rows). Its margins then nudge the tab's top to
	 * halfway between the statement's midpoint and the first prompt, and its bottom level with the
	 * last line's letters (half the line's leading up from the text's box). The text sets the height.
	 */
	@media (min-width: 48rem) {
		.layout.has-clip {
			grid-template-columns: minmax(0, 30rem) minmax(0, 22rem);
			grid-template-rows: 1fr 1fr 1fr 1fr auto;
			justify-content: space-between;
			row-gap: 0;
		}

		.has-clip .statement {
			grid-column: 1;
			grid-row: 1 / 5;
			margin-bottom: 0;
		}

		.has-clip .prose {
			grid-column: 1;
			grid-row: 5;
			margin-top: 2.5rem;
		}

		.has-clip :global(.clip-card) {
			grid-column: 2;
			grid-row: 4 / 6;
			max-width: 22rem;
			margin-block: calc((2.5rem + (1.6 - 1) * 0.72rem / 2) / 2 + 6px) calc((1.9 - 1) * 1rem / 2);
		}
	}
</style>
