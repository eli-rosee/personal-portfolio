---
/*
 * About: a one-line statement, then short paragraphs under small prompts (src/content/about.md),
 * with the climbing clip card beside them (below them on phones).
 *
 * Markdown conventions in about.md:
 *   statement: "... *phrase* ..."   the phrase is amber
 *   ### Prompt                      a label over each paragraph (the project pages' heading)
 *   first sentence                  each paragraph's lead, in the statement's Space Mono (scripts/markdown.ts)
 *   **key phrase**                  set in the text color, above the muted body
 *   [text](#target "Tip")           a bracketed link with a tooltip
 */
import { getEntry } from "astro:content";
import { compiledContent, frontmatter } from "../content/about.md";
import SectionHeading from "./SectionHeading.astro";
import ClipCard from "./ClipCard.astro";
import Prose from "./Prose.astro";
import { leadSentences, linkTooltips, listLabels, statementHtml } from "../scripts/markdown";

// The clip is optional; the section works without it
const clip = (await getEntry("clip", "clip"))?.data;

const statement: string | undefined = frontmatter.statement;
const statementLine = statement ? statementHtml(statement) : undefined;

const proseHtml = listLabels(leadSentences(linkTooltips(await compiledContent())));
---

<section id="about" class="section" aria-labelledby="about-heading">
	<SectionHeading id="about-heading" text="About" />
	<div class:list={["layout", { "has-clip": clip }]}>
		{statementLine && <p class="statement" set:html={statementLine} />}
		<Prose class="about-prose" html={proseHtml} />
		{clip && <ClipCard clip={clip} />}
	</div>
</section>

<style>
	/* One rhythm: 3.5rem after the statement and between parts, 0.75rem from a prompt to its paragraph */
	.layout {
		position: relative;
		display: grid;
		row-gap: var(--space-6);
	}

	.statement {
		max-width: 30rem; /* so the statement stays on two lines */
		margin-bottom: calc(3.5rem - var(--space-6)); /* 3.5rem to the text, counting the row gap */
		font-family: var(--font-label);
		font-size: 1.35rem;
		line-height: 1.45;
		letter-spacing: -0.01em;
		color: var(--text);
	}

	.statement :global(em) {
		font-style: normal;
		color: var(--accent);
	}

	/* The body a step dimmer than elsewhere, so the heading, then the lead, then the rest read in that order */
	.layout > :global(.about-prose) {
		max-width: 27.5rem;
		color: #7c8494;
	}

	/* Each paragraph's lead sentence in the statement's voice: the line to read if you read nothing else */
	.layout :global(.lead) {
		font-family: var(--font-label);
		font-size: 0.9rem;
		letter-spacing: -0.01em;
		color: var(--text);
	}

	.layout :global(.lead strong) {
		font-weight: 700;
		color: inherit;
	}

	/* Phones: the clip card comes right after the statement, with clear sky above the rocket for
	   its flight; the text follows */
	@media (max-width: 47.99rem) {
		.has-clip .statement {
			margin-bottom: 7rem; /* plus the row gap: 10rem above the card */
		}

		/* Capped so the portrait clip doesn't grow ~1000px tall on large phones and small tablets;
		   phones up to ~430px wide still fill the width */
		.has-clip :global(.clip-card) {
			order: 1;
			width: 100%;
			max-width: 24rem;
		}

		.has-clip > :global(.about-prose) {
			order: 2;
		}
	}

	/*
	 * Desktop: text on the left, the card on the right. The statement spans four equal rows and the
	 * card starts on the fourth, so its top sits three quarters down the statement (no measuring: a
	 * spanning item's height is shared equally by 1fr rows). Its margins then nudge the tab's top to
	 * halfway between the statement's midpoint and the first prompt, and its bottom level with the
	 * last line's letters (half the line's leading up from the text's box). The text sets the height.
	 */
	@media (min-width: 48rem) {
		.layout.has-clip {
			grid-template-columns: minmax(0, 30rem) minmax(0, 22rem);
			grid-template-rows: 1fr 1fr 1fr 1fr auto;
			justify-content: space-between;
			row-gap: 0;
		}

		.has-clip .statement {
			grid-column: 1;
			grid-row: 1 / 5;
			margin-bottom: 0;
		}

		.has-clip > :global(.about-prose) {
			grid-column: 1;
			grid-row: 5;
			margin-top: 3.5rem;
		}

		.has-clip :global(.clip-card) {
			grid-column: 2;
			grid-row: 4 / 6;
			max-width: 22rem;
			margin-block: calc((3.5rem + (1.6 - 1) * 0.875rem / 2) / 2 + 6px) calc((1.85 - 1) * 1rem / 2);
			/* Sits a few pixels lower at the same size; a translate moves nothing else */
			translate: 0 6px;
		}
	}
</style>
