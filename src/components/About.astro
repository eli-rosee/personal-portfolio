---
/*
 * About: a one-line statement, then short paragraphs under small prompts (src/content/about.md),
 * with the climbing clip card beside them (below them on phones).
 *
 * Markdown conventions in about.md:
 *   statement: "... *phrase* ..."   the phrase is amber and launches the rocket on the clip card
 *   ### Prompt                      a label over each paragraph (the project pages' heading)
 *   first sentence                  each paragraph's lead, in the statement's Space Mono (scripts/markdown.ts)
 *   **key phrase**                  set in the text color, above the muted body
 *   [text](#target "Tip")           a bracketed link with a tooltip
 */
import { getEntry } from "astro:content";
import { compiledContent, frontmatter } from "../content/about.md";
import SectionHeading from "./SectionHeading.astro";
import ClipCard from "./ClipCard.astro";
import Prose from "./Prose.astro";
import { leadSentences, linkTooltips, listLabels, statementHtml } from "../scripts/markdown";

// The clip is optional; the section works without it
const clip = (await getEntry("clip", "clip"))?.data;

// The phrase is the launch button; punctuation right after it stays on its line, next to the bracket
const statement: string | undefined = frontmatter.statement;
const launchHtml = statement
	? statementHtml(
			statement,
			(text) =>
				`<button type="button" class="launch" data-launch><em>${text}</em><span class="tooltip label" aria-hidden="true">Launch the Rocket</span></button>`,
		)
	: undefined;

const proseHtml = listLabels(leadSentences(linkTooltips(await compiledContent())));
---

<section id="about" class="section" aria-labelledby="about-heading">
	<SectionHeading id="about-heading" text="About" />
	<div class:list={["layout", { "has-clip": clip }]}>
		{launchHtml && <p class="statement" set:html={launchHtml} />}
		<Prose class="about-prose" html={proseHtml} />
		{clip && <ClipCard clip={clip} />}
		{/* The dashed flight path from the launch phrase to the rocket, drawn by the script below */}
		{launchHtml && clip && <svg class="launch-arrow" aria-hidden="true"></svg>}
	</div>
</section>

<script>
	import { initLaunchArrow } from "../scripts/launch-arrow";

	const svg = document.querySelector<SVGSVGElement>("#about .launch-arrow");
	const layout = svg?.parentElement;
	const phrase = document.querySelector<HTMLElement>("#about [data-launch]");
	const rocket = document.querySelector<SVGElement>("#about-clip .rocket");
	const statement = document.querySelector("#about .statement");
	if (svg && layout && phrase && rocket && statement) initLaunchArrow(svg, layout, phrase, rocket, statement);
</script>

<style>
	/* One rhythm: 3.5rem after the statement and between parts, 0.75rem from a prompt to its paragraph */
	.layout {
		position: relative;
		display: grid;
		row-gap: var(--space-6);
	}

	/* The flight path to the rocket: muted dashes, a pad ring, target brackets on the rocket. Out of
	   the grid's flow, over the layout. Hidden while the rocket flies, and until it's measured. */
	.launch-arrow {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		pointer-events: none;
		z-index: 1;
		fill: none;
		stroke-width: 1.25;
		stroke-linecap: round;
		stroke-linejoin: round;
		opacity: 0;
		transition: opacity 0.4s;
	}

	.launch-arrow.drawn {
		opacity: 1;
	}

	.layout:has(:global(.landing.flying)) .launch-arrow {
		opacity: 0;
	}

	.launch-arrow :global(.path) {
		stroke: var(--muted);
		stroke-opacity: 0.8;
		stroke-dasharray: 5 5;
	}

	.launch-arrow :global(.pad) {
		stroke: var(--muted);
	}

	.launch-arrow :global(.brackets) {
		stroke: var(--text);
		stroke-opacity: 0.7;
		stroke-linecap: square;
	}

	.launch-arrow :global(.chevron) {
		stroke: var(--text);
		stroke-opacity: 0.85;
		stroke-width: 1.5;
	}

	.statement {
		max-width: 30rem; /* room for the brackets, so the statement stays on two lines */
		margin-bottom: calc(3.5rem - var(--space-6)); /* 3.5rem to the text, counting the row gap */
		font-family: var(--font-label);
		font-size: 1.35rem;
		line-height: 1.45;
		letter-spacing: -0.01em;
		color: var(--text);
	}

	.statement :global(em) {
		font-style: normal;
		color: var(--accent);
	}

	/* The body a step dimmer than elsewhere, so the heading, then the lead, then the rest read in that order */
	.layout > :global(.about-prose) {
		max-width: 27.5rem;
		color: #7c8494;
	}

	/* Each paragraph's lead sentence in the statement's voice: the line to read if you read nothing else */
	.layout :global(.lead) {
		font-family: var(--font-label);
		font-size: 0.9rem;
		letter-spacing: -0.01em;
		color: var(--text);
	}

	.layout :global(.lead strong) {
		font-weight: 700;
		color: inherit;
	}

	/* The launch phrase and the links: amber, framed in amber console brackets instead of an
	   underline, with a tooltip underneath */
	.statement :global(.launch) {
		all: unset;
		position: relative;
		cursor: pointer;
	}

	.statement :global(.launch:focus-visible) {
		outline: 2px solid var(--accent); /* `all: unset` drops the global focus ring */
		outline-offset: 3px;
	}

	.statement :global(.nowrap) {
		white-space: nowrap;
	}

	.statement :global(.launch)::before {
		content: "[";
		margin-right: 0.1em;
	}

	.statement :global(.launch)::after {
		content: "]";
		margin-left: 0.1em;
	}

	.statement :global(.launch)::before,
	.statement :global(.launch)::after {
		color: var(--accent);
	}

	/* Phones: the clip card comes right after the statement, so the rocket stands just under the
	   phrase that launches it, with clear sky between them to fly in; the text follows */
	@media (max-width: 47.99rem) {
		.has-clip .statement {
			margin-bottom: 7rem; /* plus the row gap: 10rem above the card */
		}

		/* Capped so the portrait clip doesn't grow ~1000px tall on large phones and small tablets;
		   phones up to ~430px wide still fill the width */
		.has-clip :global(.clip-card) {
			order: 1;
			width: 100%;
			max-width: 24rem;
		}

		.has-clip > :global(.about-prose) {
			order: 2;
		}
	}

	/*
	 * Desktop: text on the left, the card on the right. The statement spans four equal rows and the
	 * card starts on the fourth, so its top sits three quarters down the statement (no measuring: a
	 * spanning item's height is shared equally by 1fr rows). Its margins then nudge the tab's top to
	 * halfway between the statement's midpoint and the first prompt, and its bottom level with the
	 * last line's letters (half the line's leading up from the text's box). The text sets the height.
	 */
	@media (min-width: 48rem) {
		.layout.has-clip {
			grid-template-columns: minmax(0, 30rem) minmax(0, 22rem);
			grid-template-rows: 1fr 1fr 1fr 1fr auto;
			justify-content: space-between;
			row-gap: 0;
		}

		.has-clip .statement {
			grid-column: 1;
			grid-row: 1 / 5;
			margin-bottom: 0;
		}

		.has-clip > :global(.about-prose) {
			grid-column: 1;
			grid-row: 5;
			margin-top: 3.5rem;
		}

		.has-clip :global(.clip-card) {
			grid-column: 2;
			grid-row: 4 / 6;
			max-width: 22rem;
			margin-block: calc((3.5rem + (1.6 - 1) * 0.875rem / 2) / 2 + 6px) calc((1.85 - 1) * 1rem / 2);
			/* Sits a few pixels lower at the same size; a translate moves nothing else */
			translate: 0 6px;
		}
	}
</style>
