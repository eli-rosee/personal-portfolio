---
/*
 * The console card shared by the project cards (MissionCard) and the About clip (ClipCard).
 *
 *   tab       status light, word and ⓘ, with a tooltip; left or right, or none
 *   frame     one continuous outline around the tab and the bevelled card body
 *   screen    hull edge > bezel > glass, holding whatever the wrapper slots in
 *   text      title (a link, or plain with a dash), summary, hairline, tags
 *
 * `layout="side"` is the project page's hero: the screen on the left, the title (an h1), summary and
 * any `actions` slot on the right, and the tags in a darker band along the bottom with their label.
 * A `title` slot replaces the title's text (the project pages' title art).
 *
 * Wrappers supply the screen contents and any behavior. Sizes are CSS variables on .panel
 * that a wrapper can override through `style`. Adding .is-active to .panel holds the hover look.
 */
import ExternalIcon from "./ExternalIcon.astro";
import Screen from "./Screen.astro";

interface Props {
	title: string;
	summary?: string;
	tags?: string[];
	tagsLabel?: string; // what the tag list is, for screen readers
	href?: string; // the whole card links here; without one, a static dash replaces the ↗
	external?: boolean; // the link opens in a new tab
	status?: {
		label: string;
		tone: "status" | "accent" | "muted";
		tip?: string; // tooltip text; needs a page-unique tipId
		tipId?: string;
	};
	tabSide?: "left" | "right";
	layout?: "stack" | "side";
	plain?: boolean; // the screen shows its content as it is (no grade, glare or scanlines)
	id?: string;
	class?: string;
	style?: string;
}

const {
	title,
	summary,
	tags,
	tagsLabel = "Tags",
	href,
	external = false,
	status,
	tabSide = "left",
	layout = "stack",
	plain = false,
	id,
	class: className,
	style,
} = Astro.props;
const side = layout === "side";
const Heading = side ? "h1" : "h3";
const titleArt = Astro.slots.has("title");

// Keep the tooltip to one or two snug lines: two words or fewer never wrap, and longer notes can
// only break before the last word (every other space becomes a non-breaking space)
const NBSP = "\u00a0";
const tipText =
	status?.tip &&
	(status.tip.split(" ").length <= 2 ? status.tip.replaceAll(" ", NBSP) : status.tip.replace(/ (?=.* )/g, NBSP));
---

<div
	id={id}
	class:list={["panel", `tone-${status?.tone ?? "muted"}`, { "tab-right": tabSide === "right", "no-tab": !status, side }, className]}
	style={style}
>
	{
		status && (
			<span class="tab label">
				<span class="status" tabindex={tipText ? 0 : undefined} aria-describedby={tipText && status.tipId}>
					<span class="light" aria-hidden="true" />
					<span class="status-text">{status.label}</span>
					{tipText && (
						/* Info mark: says "there's more here". Drawn on whole pixels (1px ring, the i as 1px
						   rects) at a fixed 11px, so it stays sharp at this small size */
						<svg class="info" width="11" height="11" viewBox="0 0 11 11" aria-hidden="true">
							<circle cx="5.5" cy="5.5" r="5" fill="none" stroke="currentColor" />
							<g fill="currentColor" shape-rendering="crispEdges">
								<rect x="5" y="2.5" width="1" height="1" />
								<rect x="5" y="4.5" width="1" height="4" />
							</g>
						</svg>
					)}
				</span>
				{tipText && (
					<span class="tooltip label" id={status.tipId} role="tooltip">
						{tipText}
					</span>
				)}
			</span>
		)
	}
	{/* Decoration standing on the card's top edge (the wrapper positions it) */}
	<slot name="on-top" />

	<article class="card">
		<Screen plain={plain}>
			<slot />
		</Screen>

		<div class="text">
			<Heading class="title">
				{
					href ? (
						<a class="title-link" href={href} target={external ? "_blank" : undefined} rel={external ? "noopener" : undefined}>
							<span>{title}</span>
							<ExternalIcon />
						</a>
					) : titleArt ? (
						<slot name="title" />
					) : (
						<span class="title-static">
							{title}
							{!side && <span class="static-mark" aria-hidden="true" />}
						</span>
					)
				}
			</Heading>
			{summary && <p class="summary">{summary}</p>}
			<slot name="actions" />
		</div>

		{
			tags && !side && (
				<>
					<hr class="separator" />
					<ul class="tags label" aria-label={tagsLabel}>
						{tags.map((tag) => (
							<li>{tag}</li>
						))}
					</ul>
				</>
			)
		}
		{
			tags && side && (
				<div class="band">
					<span class="label" aria-hidden="true">{tagsLabel}</span>
					<ul class="tags label" aria-label={tagsLabel}>
						{tags.map((tag) => (
							<li>{tag}</li>
						))}
					</ul>
				</div>
			)
		}
	</article>
</div>

<style>
	.panel {
		--frame-w: 2px;
		--line: var(--frame-line); /* the frame color; animatable (registered in global.css) */
		--tab-w: 12rem;
		--tab-h: 1.9rem;
		--slant: 0.75rem;
		/* How far the inner edge of a 2px slanted line sits from the outer one, along the top and
		   bottom of the slant (from the tab's proportions); keeps the slants as thick as the rest */
		--kink: 1.35px;
		--cut: 14px; /* the bevelled corners: the three away from the tab */
		/* How far the inner edge of a 2px 45° line sits from the outer one, along each side */
		--cut-kink: 0.83px;
		--status-inset: calc(32px - var(--slant)); /* light and ⓘ from the tab's outer edges */
		--screen-cut: 1rem; /* the screen's bevelled corners */
		--bezel-pad: 0.55rem;
		/* Text lines up with the inner edge of the screen's frame (margin + hull edge + bezel) */
		--inset: calc(var(--space-3) + 1px + var(--bezel-pad));
		--summary-lines: 0; /* room reserved for the summary, in lines, so cards line up */
		--tab-x: 0px; /* the tab's left edge */
		--lit: var(--muted); /* the status color */
		/* The screen's color grade, at rest and lit (hover, focus, .is-active). A wrapper whose
		   footage already has a grade baked in can override these. */
		--grade: saturate(0.75) brightness(0.8) contrast(1.1);
		--grade-lit: saturate(0.85) brightness(0.9) contrast(1.09);
		position: relative;
		padding-top: var(--tab-h);
		transition: --line 0.15s;
	}

	.tone-status {
		--lit: var(--status);
	}

	.tone-accent {
		--lit: var(--accent);
	}

	.tab-right {
		--tab-x: calc(100% - var(--tab-w));
	}

	.no-tab {
		--tab-h: 0px;
		--tab-w: 0px;
		--slant: 0px;
		--kink: 0px;
	}

	/*
	 * The outline, tab and card together, drawn as one shape: the frame color, with the panel color
	 * inset 2px inside it. One continuous edge, so the tab flows into the frame with the same
	 * thickness everywhere (two separate shapes rendered their joins unevenly on phones).
	 * Drawn with the tab on the left; a right-hand tab is the same shape mirrored.
	 */
	.panel::before,
	.panel::after {
		content: "";
		position: absolute;
		inset: 0;
	}

	.tab-right::before,
	.tab-right::after {
		scale: -1 1;
	}

	.panel::before {
		background: var(--line);
		clip-path: polygon(
			0 calc(100% - var(--cut)),
			0 var(--tab-h),
			var(--slant) 0,
			calc(var(--tab-w) - var(--slant)) 0,
			var(--tab-w) var(--tab-h),
			calc(100% - var(--cut)) var(--tab-h),
			100% calc(var(--tab-h) + var(--cut)),
			100% calc(100% - var(--cut)),
			calc(100% - var(--cut)) 100%,
			var(--cut) 100%
		);
	}

	.panel::after {
		background: var(--surface);
		clip-path: polygon(
			var(--frame-w) calc(100% - var(--cut) - var(--cut-kink)),
			var(--frame-w) var(--tab-h),
			calc(var(--slant) + var(--kink)) var(--frame-w),
			calc(var(--tab-w) - var(--slant) - var(--kink)) var(--frame-w),
			calc(var(--tab-w) - var(--kink)) calc(var(--tab-h) + var(--frame-w)),
			calc(100% - var(--cut) - var(--cut-kink)) calc(var(--tab-h) + var(--frame-w)),
			calc(100% - var(--frame-w)) calc(var(--tab-h) + var(--cut) + var(--cut-kink)),
			calc(100% - var(--frame-w)) calc(100% - var(--cut) - var(--cut-kink)),
			calc(100% - var(--cut) - var(--cut-kink)) calc(100% - var(--frame-w)),
			calc(var(--cut) + var(--cut-kink)) calc(100% - var(--frame-w))
		);
	}

	/* The tab's contents, over the outline */
	.tab {
		position: absolute;
		top: 0;
		left: var(--tab-x);
		z-index: 2; /* above the card body, so the tooltip hangs over it */
		display: flex;
		align-items: center;
		justify-content: center;
		width: var(--tab-w);
		height: var(--tab-h);
		padding: var(--frame-w) var(--slant) 0;
		user-select: none;
	}

	.tab:has([tabindex]) {
		cursor: pointer; /* a pointer over the whole tab, text included; the text isn't selectable */
	}

	/* The tab's top edge, lit in the status color */
	.tab::after {
		content: "";
		position: absolute;
		top: 0;
		left: var(--slant);
		right: var(--slant);
		height: var(--frame-w);
		background: var(--lit);
		box-shadow: 0 0 6px var(--lit);
		opacity: 0.7; /* dimmed at rest; full brightness on hover */
		transition:
			opacity 0.15s,
			box-shadow 0.15s;
	}

	/* Hover/focus: the edge brightens and a wash of its color falls into the tab, like a lamp */
	.tab::before {
		content: "";
		position: absolute;
		inset: var(--frame-w) calc(var(--frame-w) * 1.5) 0;
		clip-path: polygon(calc(var(--slant) - 1px) 0, calc(100% - var(--slant) + 1px) 0, 100% 100%, 0 100%);
		background: linear-gradient(to bottom, color-mix(in srgb, var(--lit) 22%, transparent), transparent 90%);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.15s;
	}

	.tab:is(:hover, :focus-within)::before {
		opacity: 1;
	}

	.tab:is(:hover, :focus-within)::after {
		opacity: 1;
		box-shadow: 0 0 10px var(--lit);
	}

	/* The light anchored left and the ⓘ right, with the word centered between them */
	.status {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		justify-items: center;
		width: 100%;
		padding-inline: var(--status-inset);
		color: var(--lit);
		font-size: 0.65rem;
		white-space: nowrap;
	}

	/* Widely spaced letters; the negative margin drops the last letter's trailing space so the
	   word sits truly centered */
	.status-text {
		letter-spacing: 0.3em;
		margin-right: -0.3em;
	}

	.info {
		overflow: visible; /* the ring's soft edge would be clipped at the box */
	}

	.status:focus-visible {
		outline-offset: 3px;
	}

	/* Hangs under the middle of the tab. Also shows on tap: tapping the status focuses it. */
	.tooltip {
		top: calc(100% + 0.7rem);
		width: min-content; /* as wide as its longest line */
		text-align: center;
		border-color: var(--line);
	}

	.tab:focus-within > .tooltip {
		opacity: 1;
		visibility: visible;
	}

	/* Card contents, inside the outline */
	.card {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: var(--frame-w);
	}

	/* The screen (Screen.astro), inset in the card */
	.card > :global(.viewport) {
		margin: var(--space-3) var(--space-3) 0;
	}

	.text {
		display: grid;
		align-content: start;
		gap: 0.75rem;
		flex-grow: 1; /* keeps the tags at the bottom, level across cards */
		padding: var(--space-3) var(--inset) 1.25rem;
	}

	.title {
		font-size: 1.125rem;
		letter-spacing: var(--tracking-title);
		text-transform: uppercase;
	}

	/* The ↗ (or the static mark), in proportion to the title, is pinned to the right edge of the text,
	   so it lines up across cards and never wraps a title */
	.title-link,
	.title-static {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--space-2);
		color: var(--text);
	}

	/* The ↗, larger than on the buttons: its ink is about 0.66em wide and sits flush with the text's right
	   edge (the 1em box has 0.19em of space on the right) */
	.title-link :global(svg) {
		flex-shrink: 0;
		width: 1em;
		height: 1em;
		margin-right: -0.19em;
	}

	.title-link:hover {
		text-decoration: none;
	}

	/* A linked card is one big link: the title link's box stretches over the card (above the screen's
	   contents). The tab sits outside the card, so its tooltip keeps working. */
	.title-link::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 3;
	}

	/* Keyboard focus rings the whole card, not just the title */
	.title-link:focus-visible {
		outline: none;
	}

	.card:has(.title-link:focus-visible) {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	/* A short dash, as wide as the ↗'s ink and flush with the edge like it, in the muted color */
	.static-mark {
		flex: none;
		width: 0.66em;
		height: 2px;
		background: var(--muted);
	}

	.summary {
		color: var(--muted);
		font-size: 0.875rem;
		line-height: 1.75;
		min-height: calc(var(--summary-lines) * 1lh);
		text-wrap: pretty; /* no short lines or lone last word in the narrow card */
	}

	/* Separator above the tags: a plain hairline, in the frame's resting color (it doesn't brighten) */
	.separator {
		margin: 0 var(--inset);
		border: 0;
		height: 1px;
		background: var(--frame-line);
	}

	/* Tags: "PYTHON · C · NGINX". Each "·" sits before its tag, and the list is shifted one
	   separator-width left with that strip clipped off, so a "·" that would begin a wrapped line is
	   hidden instead of dangling. Tight tracking so two long tags share a line. */
	.tags {
		--sep: 1.75em;
		display: flex;
		flex-wrap: wrap;
		margin: 0 0 0 calc(var(--inset) - var(--sep));
		padding: 1.25rem var(--inset) var(--space-3) 0;
		list-style: none;
		color: var(--accent);
		letter-spacing: 0.14em;
		clip-path: inset(0 0 0 var(--sep));
	}

	.tags li::before {
		content: "·";
		display: inline-block;
		width: var(--sep);
		text-align: center;
	}

	/*
	 * Hover (or keyboard focus, or .is-active from a wrapper) anywhere on the card, not the tab: the
	 * frame brightens slightly and the screen brightens a little, like a monitor waking up
	 */
	.panel:is(.is-active, :has(.card:hover, .title-link:focus-visible)) {
		--line: var(--frame-line-lit);
	}

	.panel:is(.is-active, :has(.card:hover, .title-link:focus-visible)) {
		--screen-grade: var(--grade-lit);
	}

	/*
	 * Side layout (the project hero): screen | text, the screen a little wider. The screen keeps its
	 * own height, centered beside the text; the title sits level with its top and the actions level
	 * with its bottom, the summary between them.
	 */
	.side .card {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		column-gap: 2.75rem;
	}

	.side .card > :global(.viewport) {
		align-self: center;
		margin: 1.5rem 0 1.75rem 1.5rem;
	}

	.side .text {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1.1rem;
		padding: calc(1.5rem + 1.2rem) calc(1.5rem + 1rem) calc(1.75rem + 1.2rem) 0;
	}

	.side .title {
		font-size: 1.85rem;
		line-height: 1.2;
	}

	.side .summary {
		color: var(--text);
		font-size: var(--text-lg);
		line-height: 1.7;
	}

	/* The tags' band: inset by the frame so the outline stays unbroken around it, its bottom corners
	   following the card's bevel */
	.band {
		grid-column: 1 / -1;
		display: flex;
		align-items: center;
		gap: 2rem;
		padding: 0.95rem 2.25rem 1.05rem;
		background: var(--bezel);
		border-top: 1px solid var(--frame-line);
		clip-path: polygon(
			0 0,
			100% 0,
			100% calc(100% - var(--cut) + 1px),
			calc(100% - var(--cut) + 1px) 100%,
			calc(var(--cut) - 1px) 100%,
			0 calc(100% - var(--cut) + 1px)
		);
	}

	.band .tags {
		margin: 0 0 0 calc(-1 * var(--sep));
		padding: 0;
		font-size: 0.78rem;
	}

	@media (max-width: 47.99rem) {
		.side .card {
			grid-template-columns: minmax(0, 1fr);
		}

		.side .card > :global(.viewport) {
			margin: var(--space-3) var(--space-3) 0;
		}

		.side .text {
			padding: var(--space-3) var(--inset) 1.5rem;
		}

		.band {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.6rem;
			padding-inline: var(--inset);
		}
	}
</style>
