---
/*
 * A telemetry readout: label (with a live light) / value / a grey note under it; no rules, just space.
 * The footer's live readouts (filled in by script, through `valueAttrs` / `noteAttrs` hooks) and the
 * facts under a project's hero. Goes inside a <dl>.
 */
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
	label: string;
	value?: string;
	note?: string;
	valueAttrs?: Record<string, string>;
	noteAttrs?: Record<string, string>; // a note element is always there when these are given
}

const { label, value, note, valueAttrs, noteAttrs, class: className, ...rest } = Astro.props;
---

<div class:list={["cell", className]} {...rest}>
	<dt class="label"><span class="light" aria-hidden="true"></span>{label}</dt>
	<dd class="value tabular" {...valueAttrs}>{value}<slot name="value" /></dd>
	{(note || noteAttrs) && <dd class="sub" {...noteAttrs}>{note}</dd>}
</div>

<style>
	.cell {
		display: grid;
		align-content: start;
		gap: 0.35rem;
		white-space: nowrap;
	}

	/* The cards' status light: each readout is a live feed */
	dt .light {
		margin-right: 0.8em;
		vertical-align: 1px;
		color: var(--status);
	}

	dd {
		margin: 0;
	}

	.value {
		color: var(--text);
		font-family: var(--font-label);
		font-size: var(--text-lg);
		line-height: 1.3;
		white-space: nowrap; /* numbers never break */
	}

	.sub {
		color: var(--muted);
		font-size: var(--text-sm);
		line-height: 1.5;
	}

	/* A note that changes flashes amber (the footer's ISS place name) */
	.sub:global(.changed) {
		animation: flash 1.5s ease-out;
	}

	/* A readout someone was sent to (the "self-hosted" link in About) */
	.cell:global(.pinged) :is(.value, .sub) {
		animation: flash 2.5s ease-out;
	}

	@keyframes flash {
		from {
			color: var(--accent);
		}
	}
</style>
