---
import { site } from "../data/site";
import ExternalIcon from "./ExternalIcon.astro";

interface Props {
	back?: boolean; // project pages: a single link back to the missions instead of the menu
}

const { back = false } = Astro.props;
---

<header>
	<nav aria-label="Main" class:list={{ back }}>
		<a class="home" href="/">{site.name}</a>
		{
			back ? (
				<a class="back-link" href="/#missions">
					<svg
						width="0.9em"
						height="0.9em"
						viewBox="0 0 12 12"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="square"
						aria-hidden="true"
					>
						<path d="M10 6H2M5 3 2 6l3 3" />
					</svg>
					All missions
				</a>
			) : (
				<ul>
					<li><a href="#missions">Projects</a></li>
					<li><a href="#about">About</a></li>
					<li>
						<a class="resume" href={site.resume} target="_blank" rel="noopener">
							Resume <ExternalIcon />
						</a>
					</li>
				</ul>
			)
		}
	</nav>
</header>

<style>
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2);
		max-width: var(--page-max);
		margin: 0 auto;
		padding: var(--space-4) var(--gutter);
		font-family: var(--font-label);
		font-size: var(--text-sm);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
	}

	.home {
		color: var(--text);
		font-weight: 700;
	}

	ul {
		display: flex;
		gap: var(--space-4);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	ul a {
		color: var(--muted);
	}

	@media (max-width: 30rem) {
		nav {
			padding-block: var(--space-3);
			font-size: var(--text-xs);
		}

		/* The big wordmark is right below on the home page; project pages keep the name */
		nav:not(.back) .home {
			display: none;
		}

		ul {
			flex: 1;
			justify-content: space-between;
		}
	}

	ul a:hover {
		color: var(--text);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.6em;
		color: var(--muted);
	}

	.back-link:hover {
		color: var(--text);
		text-decoration: none;
	}

	ul a.resume {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		color: var(--accent);
	}
</style>
