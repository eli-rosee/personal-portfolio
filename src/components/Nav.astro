---
import { Image } from "astro:assets";
import { site } from "../content/site";
import logoEr from "../assets/brand/logo-er.png";
import rocket from "../assets/brand/rocket.json";

// The logo's rocket, turned 45° like in the logo art: the viewBox is the turned drawing's bounding box
const HULL = [[50, 0], [72, 34], [72, 78], [90, 112], [90, 124], [72, 110], [28, 110], [10, 124], [10, 112], [28, 78], [28, 34]];
const FLAME = [[36, 116], [64, 116], [50, 158]];
const turned = [...HULL, ...FLAME].map(([x, y]) => [(x - y) * Math.SQRT1_2, (x + y) * Math.SQRT1_2]);
const [xs, ys] = [turned.map((p) => p[0]), turned.map((p) => p[1])];
const box = [Math.min(...xs), Math.min(...ys), Math.max(...xs) - Math.min(...xs), Math.max(...ys) - Math.min(...ys)];
---

{/*
	Pinned bar: the [ER] + rocket logo on the left, a ringed planet on the right. Every 10 seconds a
	space invader crosses the bar toward the planet; when it gets close, the planet flashes amber and
	shoots it down. A CSS animation on its own loop (a tiny script only varies the invader); off
	with reduced motion.
*/}
<header>
	<nav aria-label="Main">
		<a class="home" href="/">
			<Image class="er" src={logoEr} alt={site.name} width={82.5} densities={[1, 2]} loading="eager" />
			{/* The rocket: the same SVG drawing as every other rocket on the site, so a docking rocket
			    lands on an identical one */}
			<svg class="logo-rocket" viewBox={box.map((n) => n.toFixed(2)).join(" ")} aria-hidden="true" data-logo-rocket>
				<g transform="rotate(45)">
					<path class="hull" fill-rule="evenodd" d={rocket.hull} />
					<path class="flame" d={rocket.flame} />
				</g>
			</svg>
		</a>
		<div class="sky" aria-hidden="true">
			{/* A bar-wide box that slides right, carrying the invader at its right edge. The script picks
				a different kind for each pass; without JavaScript it's always the crab. */}
			<span class="run" data-kind="crab" data-run>
				<svg class="invader" data-kind="squid" viewBox="0 0 8 8" style="--w: 8; --h: 8" shape-rendering="crispEdges">
					<path
						class="legs-a"
						d="M3 0h2v1h-2zM2 1h4v1h-4zM1 2h6v1h-6zM0 3h2v1h-2zM3 3h2v1h-2zM6 3h2v1h-2zM0 4h8v1h-8zM2 5h1v1h-1zM5 5h1v1h-1zM1 6h1v1h-1zM3 6h2v1h-2zM6 6h1v1h-1zM0 7h1v1h-1zM2 7h1v1h-1zM5 7h1v1h-1zM7 7h1v1h-1z"
					></path>
					<path
						class="legs-b"
						d="M3 0h2v1h-2zM2 1h4v1h-4zM1 2h6v1h-6zM0 3h2v1h-2zM3 3h2v1h-2zM6 3h2v1h-2zM0 4h8v1h-8zM1 5h1v1h-1zM3 5h2v1h-2zM6 5h1v1h-1zM0 6h1v1h-1zM7 6h1v1h-1zM1 7h1v1h-1zM6 7h1v1h-1z"
					></path>
				</svg>
				<svg class="invader" data-kind="crab" viewBox="0 0 11 8" style="--w: 11; --h: 8" shape-rendering="crispEdges">
					<path
						class="legs-a"
						d="M2 0h1v1h-1zM8 0h1v1h-1zM3 1h1v1h-1zM7 1h1v1h-1zM2 2h7v1h-7zM1 3h2v1h-2zM4 3h3v1h-3zM8 3h2v1h-2zM0 4h11v1h-11zM0 5h1v1h-1zM2 5h7v1h-7zM10 5h1v1h-1zM0 6h1v1h-1zM2 6h1v1h-1zM8 6h1v1h-1zM10 6h1v1h-1zM3 7h2v1h-2zM6 7h2v1h-2z"
					></path>
					<path
						class="legs-b"
						d="M2 0h1v1h-1zM8 0h1v1h-1zM0 1h1v1h-1zM3 1h1v1h-1zM7 1h1v1h-1zM10 1h1v1h-1zM0 2h1v1h-1zM2 2h7v1h-7zM10 2h1v1h-1zM0 3h3v1h-3zM4 3h3v1h-3zM8 3h3v1h-3zM0 4h11v1h-11zM1 5h9v1h-9zM2 6h1v1h-1zM8 6h1v1h-1zM1 7h1v1h-1zM9 7h1v1h-1z"
					></path>
				</svg>
				<svg class="invader" data-kind="octopus" viewBox="0 0 12 8" style="--w: 12; --h: 8" shape-rendering="crispEdges">
					<path
						class="legs-a"
						d="M4 0h4v1h-4zM1 1h10v1h-10zM0 2h12v1h-12zM0 3h3v1h-3zM5 3h2v1h-2zM9 3h3v1h-3zM0 4h12v1h-12zM3 5h2v1h-2zM7 5h2v1h-2zM2 6h2v1h-2zM5 6h2v1h-2zM8 6h2v1h-2zM0 7h2v1h-2zM10 7h2v1h-2z"
					></path>
					<path
						class="legs-b"
						d="M4 0h4v1h-4zM1 1h10v1h-10zM0 2h12v1h-12zM0 3h3v1h-3zM5 3h2v1h-2zM9 3h3v1h-3zM0 4h12v1h-12zM2 5h3v1h-3zM7 5h3v1h-3zM1 6h2v1h-2zM5 6h2v1h-2zM9 6h2v1h-2zM2 7h2v1h-2zM8 7h2v1h-2z"
					></path>
				</svg>
			</span>
			<span class="bolt"></span>
			{/* Animated on a span, not the svg: the browser only runs a span's animation off the main thread */}
			<span class="boom">
				<svg viewBox="0 0 9 7" shape-rendering="crispEdges">
					<path
						d="M0 0h1v1h-1zM4 0h1v1h-1zM8 0h1v1h-1zM1 1h1v1h-1zM4 1h1v1h-1zM7 1h1v1h-1zM2 2h1v1h-1zM6 2h1v1h-1zM0 3h2v1h-2zM7 3h2v1h-2zM2 4h1v1h-1zM6 4h1v1h-1zM1 5h1v1h-1zM4 5h1v1h-1zM7 5h1v1h-1zM0 6h1v1h-1zM4 6h1v1h-1zM8 6h1v1h-1z"
					></path>
				</svg>
			</span>
		</div>
		{/* The planet calls in waves of invaders to shoot down (scripts/arcade.ts) */}
		<button type="button" class="planet-btn" data-planet>
			{/* The drawing, then the same drawing in amber over it, which fades in as the planet fires
			    (animating its opacity stays off the main thread; animating the strokes' color didn't) */}
			<span class="planet" aria-hidden="true">
				{["art", "art lit"].map((cls) => (
					<svg class={cls} viewBox="0 0 48 48">
						<g transform="rotate(-20 24 24)">
							<path class="ring" d="M4 24a20 6 0 0 1 40 0"></path>
							<circle class="globe" cx="24" cy="24" r="11"></circle>
							<path class="band" d="M14 21.5q10 3 20 0"></path>
							<path class="ring" d="M44 24a20 6 0 0 1-40 0"></path>
						</g>
					</svg>
				))}
			</span>
			<span class="tooltip label" id="planet-tip" role="tooltip">Defend the planet</span>
		</button>
	</nav>
	{/* The arcade's invaders, bolts, bursts and banners, over the whole bar */}
	<div class="fx" data-fx aria-hidden="true"></div>
</header>
{/* Holds the header's place in the page, since the header itself is fixed */}
<div class="header-space" aria-hidden="true"></div>

<script>
	import { initArcade } from "../scripts/arcade";
	import { initSkirmish } from "../scripts/skirmish";

	initSkirmish(document.querySelector("header nav")!);
	initArcade(document.querySelector("header")!);

	// On the home page the logo glides back to the top instead of reloading the page
	const home = document.querySelector<HTMLAnchorElement>("header .home");
	home?.addEventListener("click", (event) => {
		if (location.pathname !== "/") return;
		event.preventDefault();
		scrollTo({ top: 0, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
	});
</script>

<style define:vars={{ logoGap: `${rocket.navLogo.gap}px`, logoRocket: `${rocket.navLogo.rocketHeight}px` }}>
	/* Full-width bar on the page background, with a 1px rule under it */
	/* Fixed, not sticky: when the page bounces past the top (trackpads, phones), the page moves and the
	   bar stays put. The spacer below holds its place: the planet (the bar's tallest item) plus the bar's
	   padding and its 1px rule. */
	header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 10;
		background: var(--bg);
		border-bottom: var(--border-width) solid var(--border);
	}

	.header-space {
		height: calc(60px + 2 * var(--space-3) + var(--border-width));
	}

	nav {
		/* Skirmish timing, shared by the invader's lane and the planet's flash so they stay in step */
		--cycle: 10s;
		--delay: 2s; /* first pass shortly after the page loads */
		display: flex;
		align-items: center;
		max-width: var(--page-max);
		margin: 0 auto;
		padding: var(--space-3) var(--gutter);
	}

	/* [ER] (an image) and the rocket (SVG), sized and spaced as in the logo art (rocket.json navLogo).
	   --logo scales the whole logo (smaller on phones). */
	.home {
		--logo: 1;
		flex: none;
		display: flex;
		align-items: center;
		gap: calc(var(--logoGap) * var(--logo));
	}

	.home > * {
		display: block;
		transition:
			translate 0.2s,
			filter 0.2s;
	}

	.er {
		width: calc(82.5px * var(--logo));
		height: auto;
	}

	.logo-rocket {
		height: calc(var(--logoRocket) * var(--logo));
		width: auto;
		overflow: visible;
	}

	.logo-rocket .hull {
		fill: var(--text);
	}

	.logo-rocket .flame {
		fill: var(--accent);
	}

	/* The logo is the way home on every page: it brightens and lifts slightly on hover */
	.home:is(:hover, :focus-visible) > * {
		translate: 0 -2px;
		filter: brightness(1.15);
	}

	/*
	 * The skirmish. One 10s cycle, shared by every part so they stay in step (times in seconds):
	 *   0.3-0.9  the invader fades in as it sets off (the lane starts well clear of the logo)
	 *   4.3      it reaches firing range (--range short of the planet)
	 *   3.9-4.3  the planet flashes and its bolt crosses the gap
	 *   4.3      hit: the invader becomes an explosion, which fades by 4.8
	 * About 6s later (10.3, the next cycle's 0.3) the next invader appears.
	 */
	.sky {
		--range: 2.75rem; /* how close the invader gets before it's shot */
		--px: 2px; /* one pixel of the pixel art: a whole number keeps the edges sharp */
		position: relative;
		flex: 1;
		align-self: center;
		height: 0;
		margin: 0 0.5rem 0 12rem; /* the invader appears partway across, well clear of the logo */
		pointer-events: none;
		transition: opacity 0.3s;
	}

	/* Out of the way while a wave plays */
	.sky.off {
		opacity: 0;
	}

	.sky > *,
	.planet .lit {
		animation-duration: var(--cycle);
		animation-delay: var(--delay);
		animation-iteration-count: infinite;
	}

	.run {
		position: absolute;
		top: 0;
		right: 100%;
		width: 100%;
		opacity: 0;
		animation-name: invader-advance;
		animation-timing-function: linear;
	}

	/* Only the kind picked for this pass shows; each sprite sizes itself from its pixel grid */
	.invader {
		display: none;
		position: absolute;
		top: 0;
		right: 0;
		width: calc(var(--w) * var(--px) * var(--scale, 1));
		height: calc(var(--h) * var(--px) * var(--scale, 1));
		translate: 0 -50%;
		fill: var(--text);
	}

	.run[data-kind="squid"] [data-kind="squid"],
	.run[data-kind="crab"] [data-kind="crab"],
	.run[data-kind="octopus"] [data-kind="octopus"] {
		display: block;
	}

	/* The squid is the smallest alien in the arcade; a little extra size keeps it easy to see */
	.invader[data-kind="squid"] {
		--scale: 1.25;
	}

	/* Two leg poses, swapping like the arcade original */
	.invader :is(.legs-a, .legs-b) {
		animation: invader-legs 0.8s steps(1) infinite;
	}

	.invader .legs-b {
		animation-delay: -0.4s;
	}

	.bolt {
		position: absolute;
		top: 0;
		right: 0;
		width: 0.5rem;
		height: 2px;
		translate: 0 -50%;
		background: var(--accent);
		box-shadow: 0 0 6px var(--accent);
		opacity: 0;
		animation-name: invader-fire;
		animation-timing-function: linear;
	}

	.boom {
		position: absolute;
		top: 0;
		right: var(--range);
		width: calc(9 * var(--px));
		height: calc(7 * var(--px));
		translate: 0 -50%;
		fill: var(--accent);
		opacity: 0;
		animation-name: invader-burst;
	}

	.boom svg {
		display: block;
		width: 100%;
		height: 100%;
	}

	/* Keyframe names are global across the page (the footer has its own "flash"), hence the prefixes */
	@keyframes invader-advance {
		0%,
		3% {
			translate: 0 0;
			opacity: 0;
		}
		9% {
			opacity: 1;
		}
		43% {
			translate: calc(100% - var(--range)) 0;
			opacity: 1;
		}
		43.01%,
		100% {
			translate: calc(100% - var(--range)) 0;
			opacity: 0;
		}
	}

	@keyframes invader-fire {
		0%,
		40% {
			translate: 0 -50%;
			opacity: 0;
		}
		40.01% {
			opacity: 1;
		}
		43% {
			translate: calc(-1 * var(--range)) -50%;
			opacity: 1;
		}
		43.01%,
		100% {
			translate: calc(-1 * var(--range)) -50%;
			opacity: 0;
		}
	}

	@keyframes invader-burst {
		0%,
		43% {
			opacity: 0;
			scale: 0.7;
		}
		43.01% {
			opacity: 1;
			scale: 1;
		}
		48%,
		100% {
			opacity: 0;
			scale: 1.3;
		}
	}

	@keyframes invader-legs {
		50% {
			opacity: 0;
		}
	}

	/* With JavaScript, scripts/skirmish.ts plays these same keyframes one pass at a time, on the compositor,
	   and swaps the legs by a timer while the invader is on screen; the CSS version stands down */
	nav.scripted .sky > *,
	nav.scripted .planet .lit,
	nav.scripted .sky .invader :is(.legs-a, .legs-b) {
		animation: none;
	}

	/* Pose a until the script says b (the pose rules match the same chain, plus the pose, so they win) */
	nav.scripted .sky .run .invader .legs-b,
	nav.scripted .sky .run[data-pose="b"] .invader .legs-a {
		opacity: 0;
	}

	nav.scripted .sky .run[data-pose="b"] .invader .legs-b {
		opacity: 1;
	}

	.planet-btn {
		--planet: 60px;
		position: relative;
		flex: none;
		display: block;
		padding: 0;
		border: 0;
		background: none;
		font: inherit;
		cursor: pointer;
	}

	.planet-btn:focus-visible {
		outline: 1px solid var(--accent);
		outline-offset: 4px;
	}

	/* No waves (reduced motion, or a touch screen; scripts/arcade.ts disables it): the planet is just a
	   drawing */
	.planet-btn:disabled {
		cursor: default;
	}

	.planet-btn:disabled > .tooltip {
		display: none;
	}

	.planet {
		position: relative;
		display: block;
		width: var(--planet);
		height: var(--planet);
		transition:
			filter 0.2s,
			opacity 0.6s,
			scale 0.6s;
	}

	/* Hover brightens it, like the logo (not while it fires, which would wash the amber out) */
	.planet-btn:not(:disabled):is(:hover, :focus-visible) .planet:not(.firing) {
		filter: brightness(1.35);
	}

	/* The tooltip hangs from the planet's right side (it's at the edge of the bar), its notch under
	   the planet's middle. Gone from the click that starts a game until the game is over. */
	.planet-btn > .tooltip {
		left: auto;
		right: 0;
		translate: none;
		white-space: nowrap;
	}

	.planet-btn > .tooltip::before {
		left: auto;
		right: calc(var(--planet) / 2 - 3.5px);
	}

	.planet-btn.playing > .tooltip {
		opacity: 0;
		visibility: hidden;
		transition: none;
	}

	/* Space is the trigger during a game, so no focus ring on the planet */
	.planet-btn.playing:focus-visible {
		outline: none;
	}

	.planet .art {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.planet .lit {
		position: absolute;
		inset: 0;
		opacity: 0;
		animation-name: planet-flash;
	}

	.planet .globe {
		fill: var(--surface);
		stroke: var(--muted);
		stroke-width: 1.5;
	}

	.planet .ring,
	.planet .band {
		fill: none;
		stroke: var(--muted);
		stroke-width: 1.5;
	}

	.planet .band {
		stroke: var(--border);
	}

	/* The amber copy: the planet lit up as it fires */
	.planet .lit :is(.globe, .ring) {
		stroke: var(--accent);
	}

	/* During a game: calm silences the skirmish's flash and firing is a shot (!important outranks the
	   flash without restarting it, so it stays in step with the invader); won is the victory's green ring */
	.planet:global(.calm) .lit {
		opacity: 0 !important;
	}

	.planet:global(.firing) .lit {
		opacity: 1 !important;
	}

	.planet:global(.won) .art :is(.globe, .ring) {
		stroke: var(--status);
	}

	/* Game over: gone at once (its pieces fly off), then it forms again over 0.6s */
	.planet:global(.shattered) {
		opacity: 0;
		scale: 0.6;
		transition-duration: 0.1s;
	}

	/* The wave: everything here is made by scripts/arcade.ts and placed with `translate` */
	.fx {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	/* An invader, centered on its spot in the lane */
	.fx :global(.foe) {
		position: absolute;
		left: 0;
		top: 0;
		padding: 10px;
		transform: translate(-50%, -50%);
		line-height: 0;
	}

	.fx :global(.foe .invader) {
		display: block;
		position: static;
		translate: none;
	}

	/* An octopus's first hit */
	.fx :global(.foe.hurt .invader) {
		fill: var(--accent);
	}

	.fx :global(.bolt) {
		position: absolute;
		left: -0.25rem;
		top: -1px;
		width: 0.5rem;
		height: 2px;
		background: var(--accent);
		box-shadow: 0 0 6px var(--accent);
	}

	.fx :global(.burst) {
		position: absolute;
		left: 0;
		top: 0;
		width: calc(9 * var(--px));
		height: calc(7 * var(--px));
		transform: translate(-50%, -50%);
		fill: var(--accent);
	}

	/* Wave numbers and the result, centered on their spot */
	.fx :global(.banner) {
		position: absolute;
		left: 0;
		top: 0;
		transform: translate(-50%, -50%);
		padding: 0.2rem calc(0.6rem - 0.4em) 0.2rem 0.6rem; /* less on the right: the tracking trails the last letter */
		background: var(--bg);
		font-family: var(--font-label);
		letter-spacing: 0.4em;
		text-transform: uppercase;
		white-space: pre;
		color: var(--text);
	}

	.fx :global(.banner.accent) {
		color: var(--accent);
	}

	/* How to fire, under the lane through the first wave */
	.fx :global(.tipline) {
		position: absolute;
		left: 0;
		top: 0;
		transform: translate(-50%, -50%);
		font-family: var(--font-label);
		font-size: var(--text-xs);
		letter-spacing: 0.2em;
		text-transform: uppercase;
		white-space: pre;
		color: var(--muted);
	}

	.fx :global(.tipline b) {
		font-weight: 400;
		color: var(--text);
	}

	/* The planet's pieces when it breaks */
	.fx :global(.debris) {
		position: absolute;
		left: -1.5px;
		top: -1.5px;
		width: 3px;
		height: 3px;
		background: var(--muted);
	}

	.fx :global(.debris.lit) {
		background: var(--accent);
	}

	@keyframes planet-flash {
		0%,
		39.3% {
			opacity: 0;
		}
		40.2%,
		47.4% {
			opacity: 1;
		}
		52.8%,
		100% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.sky {
			display: none;
		}

		.home:is(:hover, :focus-visible) > * {
			translate: none;
		}

		.planet .lit {
			display: none;
		}
	}

	@media (max-width: 30rem) {
		nav {
			padding-block: var(--space-2);
		}

		.header-space {
			height: calc(44px + 2 * var(--space-2) + var(--border-width)); /* the phone planet and padding */
		}

		.home {
			--logo: 0.758; /* 97px instead of 128px wide */
		}

		.sky {
			--range: 2rem;
			--px: 1.5px; /* whole device pixels on 2x phone screens */
			margin-left: 4rem;
		}

		.planet-btn {
			--planet: 44px;
		}

		.fx :global(.banner) {
			font-size: var(--text-xs);
			letter-spacing: 0.25em;
		}

