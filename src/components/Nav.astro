---
import { Image } from "astro:assets";
import { site } from "../data/site";
import logo from "../assets/logo.png";
---

{/* Pinned bar: the [ER] + rocket logo on the left, a ringed planet on the right */}
<header>
	<nav aria-label="Main">
		<a class="home" href="/">
			<Image src={logo} alt={site.name} width={125} densities={[1, 2]} loading="eager" />
		</a>
		<svg class="planet" viewBox="0 0 48 48" aria-hidden="true">
			<g transform="rotate(-20 24 24)">
				<path class="ring" d="M4 24a20 6 0 0 1 40 0"></path>
				<circle class="globe" cx="24" cy="24" r="11"></circle>
				<path class="band" d="M14 21.5q10 3 20 0"></path>
				<path class="ring" d="M44 24a20 6 0 0 1-40 0"></path>
			</g>
		</svg>
	</nav>
</header>

<style>
	/* Full-width bar on the page background, with a 1px rule under it */
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: var(--bg);
		border-bottom: var(--border-width) solid var(--border);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: var(--page-max);
		margin: 0 auto;
		padding: var(--space-3) var(--gutter);
	}

	.home img {
		display: block;
		width: 125px;
	}

	.planet {
		width: 44px;
		height: 44px;
		overflow: visible;
	}

	.planet .globe {
		fill: var(--surface);
		stroke: var(--muted);
		stroke-width: 1.5;
	}

	.planet .ring,
	.planet .band {
		fill: none;
		stroke: var(--muted);
		stroke-width: 1.5;
	}

	.planet .band {
		stroke: var(--border);
	}

	@media (max-width: 30rem) {
		nav {
			padding-block: var(--space-2);
		}

		.home img {
			width: 95px;
		}

		.planet {
			width: 34px;
			height: 34px;
		}
	}
</style>
