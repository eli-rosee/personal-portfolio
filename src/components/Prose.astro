---
/*
 * Written text from Markdown, in the About section's type (the home About, a project's About):
 *   ### Prompt        a label over a paragraph
 *   **key phrase**    in a soft white, above the muted body and under the leads
 *   [text](url)       amber console brackets instead of an underline (a title becomes a tooltip)
 *   - item            a list, each line led by the cards' short muted dash
 *   1. step           a list in order, each line led by a muted mono step number (01, 02, …)
 *   - **Label:** text a list item with a bold label, a few spaces after its colon
 *   ```math          equations, one a line, beside a 1px rule (mathBlock in src/scripts/markdown.ts)
 */
interface Props {
	html: string;
	class?: string;
}

const { html, class: className } = Astro.props;
---

<div class:list={["prose", className]} set:html={html} />

<style>
	/* Red Hat Text, a touch lighter than --muted so the paragraphs stay easy to read */
	.prose {
		font-family: "Red Hat Text", sans-serif;
		font-size: 1rem;
		line-height: 1.85;
		color: #a3abba;
	}

	/* Prompts: light white Red Hat Mono, like the project pages' About headings (ProjectAbout.astro) */
	.prose :global(h3) {
		margin: 3.5rem 0 0.75rem;
		font-family: "Red Hat Mono", monospace;
		font-size: 0.875rem;
		font-weight: 300;
		line-height: 1.6;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text);
	}

	.prose :global(h3:first-child) {
		margin-top: 0;
	}

	/* A soft white, a step under the leads' cream, so a bold phrase never outshines a section's first sentence */
	.prose :global(strong) {
		font-weight: 600;
		color: #b3b9c4;
	}

	.prose :global(:is(p, ul, ol) + :is(p, ul, ol)) {
		margin-top: 1em;
	}

	/* Links: amber, framed in amber console brackets instead of an underline, with a tooltip underneath */
	.prose :global(a) {
		position: relative;
		white-space: nowrap;
		text-decoration: none;
	}

	.prose :global(a)::before {
		content: "[";
		margin-right: 0.1em;
	}

	.prose :global(a)::after {
		content: "]";
		margin-left: 0.1em;
	}

	.prose :global(:is(ul, ol)) {
		display: grid;
		gap: 0.9rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Tighter leading than the paragraphs, so an item's wrapped lines hold together and the gap marks the next */
	.prose :global(li) {
		position: relative;
		padding-left: 1.4rem;
		line-height: 1.65;
	}

	/* A list item's bold label (listLabels in scripts/markdown.ts): a wider gap after its colon */
	.prose :global(strong.term) {
		margin-right: 0.5em;
	}

	/* The dash, level with the middle of the first line */
	.prose :global(ul > li)::before {
		content: "";
		position: absolute;
		left: 0;
		top: calc(0.825em - 1px);
		width: 0.6rem;
		height: 2px;
		background: var(--muted);
	}

	/* Steps: a muted mono number in place of the dash */
	.prose :global(ol) {
		counter-reset: step;
	}

	.prose :global(ol > li) {
		counter-increment: step;
		padding-left: 2.4rem;
	}

	.prose :global(ol > li)::before {
		content: counter(step, decimal-leading-zero);
		position: absolute;
		left: 0;
		top: 0.28em;
		font-family: "Red Hat Mono", monospace;
		font-size: 0.8125rem;
		font-weight: 300;
		letter-spacing: 0.08em;
		color: var(--muted);
	}

	/* Equations: Plex Mono beside a 1px rule, like a quoted aside; a group's label (Predict:) in its own
	   column, notes dimmed after them */
	.prose :global(.math) {
		display: grid;
		grid-template-columns: 5.5rem max-content minmax(0, 1fr);
		column-gap: 2rem;
		align-items: baseline;
		margin-block: 1.75rem;
		padding: 0.25rem 0 0.25rem 1.5rem;
		border-left: var(--border-width) solid var(--frame-line);
		font-family: var(--font-body);
		font-size: 0.9rem;
		line-height: 1.75;
		color: #b3b9c4;
	}

	.prose :global(.math-label) {
		grid-column: 1;
		font-family: var(--font-label);
		font-size: 0.68rem;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--muted);
	}

	.prose :global(.math-eq) {
		grid-column: 2;
		white-space: pre;
	}

	.prose :global(.math-note) {
		grid-column: 3;
		font-size: 0.8rem;
		color: #6b7385;
	}

	.prose :global(.math-gap) {
		grid-column: 1 / -1;
		height: 0.9rem;
	}

	.prose :global(.math-bare) {
		grid-template-columns: max-content minmax(0, 1fr);
	}

	.prose :global(.math-bare .math-eq) {
		grid-column: 1;
	}

	.prose :global(.math-bare .math-note) {
		grid-column: 2;
	}

	.prose :global(.math :is(sub, sup)) {
		font-size: 0.7em;
		line-height: 0;
	}

	/* Phones: notes drop under their equation */
	@media (max-width: 47.99rem) {
		.prose :global(.math) {
			grid-template-columns: 4.75rem minmax(0, 1fr);
			column-gap: 1rem;
			padding-left: 1rem;
		}

		.prose :global(.math-note) {
			grid-column: 2;
			line-height: 1.5;
		}

		.prose :global(.math-bare) {
			grid-template-columns: minmax(0, 1fr);
		}

		.prose :global(.math-bare .math-note) {
			grid-column: 1;
		}
	}
</style>
