---
/*
 * The end of a project page: "Next stop: <name> ↗" (a plain link), and "or [take the scenic route]",
 * which counts down and flies the rocket off its launchpad, up the page and into the logo while the
 * next project fades in under it (src/scripts/flight.ts). The dashed flight path from the phrase to
 * the rocket is drawn by the same script.
 */
import type { CollectionEntry } from "astro:content";
import SectionHeading from "../SectionHeading.astro";
import ExternalIcon from "../ExternalIcon.astro";
import rocket from "../../assets/brand/rocket.json";

interface Props {
	next: CollectionEntry<"projects">;
	scale?: number;
}

const { next, scale = 1.6 } = Astro.props;
const href = `/projects/${next.id}/`;
---

<section class="next" aria-labelledby="next-heading">
	<SectionHeading id="next-heading" text="Next project" />
	<div class="row" style={`--s: ${scale}`}>
		<div class="col">
			<p class="statement big">Next stop: <a class="name" href={href}>{next.data.title} <span class="arr"><ExternalIcon /></span></a></p>
			<p class="statement small">
				or <button type="button" class="phrase" data-launch={href}><em>take the scenic route</em><span class="tooltip label" aria-hidden="true">Launch the Rocket</span></button>
			</p>
		</div>
		<button class="launch" type="button" data-launch={href} aria-label={`Launch to ${next.data.title}`}>
			<span class="stand">
				{/* The rocket; its flame is a layer of its own after the pad (below), so the flicker runs on the
				    compositor and the flame burns in front of the deck */}
				<span class="craft">
					<svg class="rk" viewBox="0 0 100 124" aria-hidden="true"><path class="hull" d={rocket.hull} /></svg>
				</span>
				{/* The launchpad, drawn around the rocket's feet (0, 0): a slab deck, a lattice tower on the right
				    with two service arms and a status light, a propellant sphere on the left. The parts that move in
				    the countdown (the arms, the fuel line, the light) are layers of their own over the same box, so
				    they move on the compositor; the arms' layer is clipped where they'd pass the deck. */}
				<span class="pad-layer arms" aria-hidden="true">
					<svg class="part arm a1" viewBox="-42 -40 88 44"><path d="M25 -22H6.5" /></svg>
					<svg class="part arm a2" viewBox="-42 -40 88 44"><path d="M25 -12H7.5" /></svg>
				</span>
				<svg class="pad" viewBox="-42 -40 88 44" aria-hidden="true">
					<g class="base">
						<g class="tower">
							<path class="rails" d="M25 0V-36M30 0V-36M24 -36H31" />
							<path class="lattice" d="M25 -36L30 -30L25 -24L30 -18L25 -12L30 -6L25 0M30 -36L25 -30L30 -24L25 -18L30 -12L25 -6L30 0" />
						</g>
						<rect class="slab" x="-17" y="0" width="51" height="3.5" rx="1.75" />
						<g class="tank">
							<path class="slab" d="M-38.75 0H-14V3.5H-38.75A1.75 1.75 0 0 1 -38.75 0Z" />
							<circle class="sphere" cx="-30" cy="-10" r="6.5" />
							<path class="legs" d="M-34 -5L-35.5 0M-26 -5L-24.5 0" />
						</g>
					</g>
				</svg>
				<span class="pad-layer" aria-hidden="true">
					<svg class="part pipe" viewBox="-42 -40 88 44"><path d="M-24.2 -7.2Q-21.6 -4.4 -18 -4.4H-9.4" /></svg>
				</span>
				<span class="pad-layer" aria-hidden="true">
					<svg class="part pad-light" viewBox="-42 -40 88 44"><rect class="light-sq" x="26" y="-31.5" width="3" height="3" /></svg>
				</span>
				<span class="burn" aria-hidden="true">
					<svg class="rk-flame" viewBox="0 0 100 124"><path class="flame" d={rocket.flame} /></svg>
				</span>
			</span>
		</button>
		<svg class="launch-arrow" aria-hidden="true"></svg>
	</div>
</section>

<style>
	.next {
		padding: 6rem 0 2rem;
	}

	.row {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.col {
		display: grid;
		gap: 0.7rem;
	}

	.statement {
		font-family: var(--font-label);
		line-height: 1.45;
		letter-spacing: -0.01em;
		color: var(--muted);
	}

	.big {
		font-size: 1.5rem;
	}

	.small {
		font-size: 1rem;
	}

	.name {
		color: var(--text);
		white-space: nowrap;
	}

	.name:hover {
		text-decoration: none;
	}

	.arr {
		display: inline-block;
		color: var(--muted);
		transition: color 0.15s;
	}

	.arr :global(svg) {
		width: 1em;
		height: 1em;
		vertical-align: -0.1em;
	}

	.name:is(:hover, :focus-visible) .arr {
		color: var(--text);
	}

	/* The launch phrase: the home About's amber bracketed phrase */
	.phrase {
		all: unset;
		position: relative;
		cursor: pointer;
		white-space: nowrap;
	}

	.phrase em {
		font-style: normal;
		color: var(--accent);
	}

	.phrase::before {
		content: "[";
		margin-right: 0.1em;
		color: var(--accent);
	}

	.phrase::after {
		content: "]";
		margin-left: 0.1em;
		color: var(--accent);
	}

	.phrase:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	.launch {
		all: unset;
		cursor: pointer;
		margin-right: calc(21.5px * var(--s) + 7px); /* the brackets' right side on the column's edge (the deck reaches 34 units right of the rocket's center) */
		translate: 0 var(--shift, 0px); /* centered on the two lines of text (flight.ts) */
	}

	.launch:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 10px;
	}

	.stand {
		position: relative;
		display: block;
	}

	/* The logo rocket at 1.6x (--s scales the rocket and pad together); its engine is dark until the countdown */
	.craft {
		display: block;
	}

	/* The flame's layer: over the rocket's box (it shakes with the rocket), in front of the pad */
	.burn {
		position: absolute;
		top: 0;
		left: 0;
		width: calc(25px * var(--s));
	}

	.rk {
		display: block;
		width: calc(25px * var(--s));
		overflow: visible;
	}

	.rk .hull {
		fill: var(--text);
		fill-rule: evenodd;
		transition: fill 0.15s;
	}

	/* The flicker pivots on the top middle of the flame (50, 116 in the drawing) */
	.rk-flame {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		overflow: visible;
		fill: var(--accent);
		opacity: 0;
		transform-origin: 50% calc(116 / 124 * 100%);
	}

	.row:has(:is(.phrase, .launch):is(:hover, :focus-visible)) .rk .hull {
		fill: #fff;
	}

	/* The pad and its moving layers share one box: 88 x 44 drawing units, the unit --s px */
	.pad,
	.pad-layer {
		position: absolute;
		left: 50%;
		bottom: calc(-4px * var(--s));
		width: calc(88px * var(--s));
		translate: calc(-42px * var(--s)) 0;
		overflow: visible;
		fill: none;
		stroke-width: 1;
	}

	/* A moving part fills its layer. On an <svg> only `transform` runs on the compositor (not `rotate` or
	   `scale`), so the layer (an HTML box) does the positioning and the part only transforms, about a
	   point (x, y) of the drawing. */
	span.pad-layer {
		height: calc(44px * var(--s));
	}

	.part {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		--ox: calc((var(--x) + 42) / 88 * 100%);
		--oy: calc((var(--y) + 40) / 44 * 100%);
		transform-origin: var(--ox) var(--oy);
	}

	.rails {
		stroke: var(--muted);
		stroke-opacity: 0.8;
	}

	.lattice {
		stroke: var(--muted);
		stroke-opacity: 0.35;
		stroke-width: 0.75;
	}

	.slab {
		fill: var(--frame-line-lit);
		stroke: none;
	}

	.sphere {
		fill: var(--surface);
		stroke: var(--muted);
		stroke-opacity: 0.85;
	}

	.legs {
		stroke: var(--muted);
		stroke-opacity: 0.7;
		stroke-width: 0.9;
	}

	/* The fuel line lets go of the rocket at T-2 and drops toward the deck, pivoting where it leaves the
	   tank (14° brings its free end down to the deck, beside the left fin), fading out like the arms */
	.pipe {
		--x: -24.2;
		--y: -7.2;
		stroke: var(--muted);
		stroke-opacity: 0.55;
		stroke-width: 0.9;
		transition:
			transform 0.4s cubic-bezier(0.55, 0, 1, 0.45), /* falling: slow off the rocket, then faster */
			opacity 1s 0.9s; /* rests on the deck 0.5s after the fall, then fades, gone just before liftoff */
	}

	.row:global(.fuel-off) .pipe,
	.row:global(.flying) .pipe {
		transform: rotate(14deg);
		opacity: 0;
	}

	/* The service arms swing down against the tower at T-1, at one steady rate, fading out as they go; the
	   lower one is clipped where it would pass the deck (1.5 units below the deck's top, 2.5 above the
	   box's bottom) */
	.arms {
		clip-path: inset(0 0 calc(2.5px * var(--s)) 0);
	}

	.arm {
		stroke: var(--muted);
		stroke-opacity: 0.8;
		transition:
			transform 0.8s linear,
			opacity 1.3s; /* a little slower than the swing: still fading as the rocket lifts off */
	}

	.a1 {
		--x: 25;
		--y: -22;
	}

	.a2 {
		--x: 25;
		--y: -12;
	}

	.row:global(.arms-back) .arm,
	.row:global(.flying) .arm {
		transform: rotate(-70deg);
		opacity: 0;
	}

	/* The status light on the tower: amber while it waits, green at liftoff; it flashes about its middle */
	.pad-light {
		--x: 27.5;
		--y: -30;
	}

	.light-sq {
		fill: #ffb54d;
		filter: drop-shadow(0 0 2px var(--accent)) drop-shadow(0 0 4px rgb(242 165 65 / 0.6));
		transition:
			fill 0.2s,
			filter 0.2s;
	}

	.row:global(.go) .light-sq,
	.row:global(.flying) .light-sq {
		fill: #8fdc93;
		filter: drop-shadow(0 0 2px var(--status)) drop-shadow(0 0 4px rgb(123 196 127 / 0.6));
	}

	/* The flight path (the home About's look): muted dashes, a pad ring, target brackets, a chevron */
	.launch-arrow {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		pointer-events: none;
		fill: none;
		stroke-width: 1.25;
		stroke-linecap: round;
		stroke-linejoin: round;
		opacity: 0;
		transition: opacity 0.4s;
	}

	.launch-arrow:global(.drawn) {
		opacity: 1;
	}

	.row:global(.flying) .launch-arrow {
		opacity: 0 !important;
	}

	.launch-arrow :global(.path) {
		stroke: var(--muted);
		stroke-opacity: 0.8;
		stroke-dasharray: 5 5;
	}

	.launch-arrow :global(.ring) {
		stroke: var(--muted);
	}

	.launch-arrow :global(.brackets) {
		stroke: var(--text);
		stroke-opacity: 0.7;
		stroke-linecap: square;
	}

	.launch-arrow :global(.chevron) {
		stroke: var(--text);
		stroke-opacity: 0.85;
		stroke-width: 1.5;
	}

	/* Phones: the launch sits under the text, the path coming down to it (flight.ts) */
	@media (max-width: 47.99rem) {
		.row {
			flex-direction: column;
			align-items: flex-start;
			gap: 4rem;
		}

		.launch {
			align-self: center;
			margin: 0;
		}

		.big {
			font-size: 1.2rem;
		}
	}
</style>

<style is:global>
	/* Made by flight.ts: the countdown over the pad, the flying rocket and its contrail */
	.countdown {
		position: absolute;
		z-index: 45;
		translate: -50% -100%;
		color: var(--accent);
		font-family: var(--font-label);
		font-size: 1.15rem;
		font-weight: 700;
		letter-spacing: var(--tracking-title);
		text-transform: uppercase;
		white-space: nowrap;
		pointer-events: none;
	}

	/* The flying rocket: the logo's rocket as two layers, its hull and its flame, so the flame's flicker
	   (flight.ts) runs on the compositor like the flight, about the top middle of the flame (--fx, --fy) */
	.ship {
		position: fixed;
		z-index: 40;
		pointer-events: none;
		will-change: transform;
	}

	.ship > svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.ship .hull {
		fill: var(--text);
		fill-rule: evenodd;
	}

	.ship .flame {
		fill: var(--accent);
	}

	.ship .ship-flame {
		transform-origin: var(--fx) var(--fy);
	}

	/* The page under the flight ignores the pointer: content gliding under a still mouse would otherwise be
	   hit-tested and restyled for hover every frame */
	html.in-flight :is(main, footer) {
		pointer-events: none;
	}

	.contrail {
		position: fixed;
		inset: 0;
		z-index: 39;
		width: 100vw;
		height: 100vh;
		pointer-events: none;
	}
</style>
