---
/*
 * The theater: a project's figures and media, large, over the dimmed page. Anything with
 * data-theater="<id>" opens that item. One job per corner of the screen: where you are (top left), Close
 * (top right), title and caption (bottom left), a hint (bottom right). Under it a strip of every item,
 * held still and centered, in two groups: About (the write-up's figures) and Media (the cards).
 * Images take one of two screen shapes (landscape 16:9, portrait 3:4), tall clips 9:16 (phone video);
 * everything is shown whole. Arrow keys, the strip, or a swipe move between items; with a mouse, a click
 * zooms an image; a click pauses or resumes a clip; a video plays with its own bar (Player.astro), from
 * where its card left off, and the card picks up where the theater left off. Each thumbnail says what it is. Esc, Close or a click
 * outside closes it. src/scripts/theater.ts runs it.
 */
import Screen from "../Screen.astro";
import Visual from "./Visual.astro";
import Player from "./Player.astro";
import { shapeOf, type Asset } from "../../scripts/project-files";

export type Pane = { id: string; group: "About" | "Media"; title: string; caption?: string; alt?: string } & (
	| { kind: "visual"; asset: Asset }
	| { kind: "video"; asset: Asset; poster?: Asset }
	| { kind: "slides"; slides: Asset[]; pdf?: Asset }
);

interface Props {
	panes: Pane[];
}

const { panes } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
// A tall clip is phone video, 9:16; a tall image gets the portrait screen, 3:4
const isClip = (p: Pane) => p.kind === "visual" && p.asset.kind === "clip";
const shape = (p: Pane) => {
	const s = p.kind === "visual" ? shapeOf(p.asset) : "landscape";
	return s === "portrait" && isClip(p) ? "tall" : s;
};
// A still image can be zoomed and a clip paused; the hint says so
const zoomable = (p: Pane) => p.kind === "visual" && (p.asset.kind === "image" || p.asset.kind === "gif");
const hint = (p: Pane) => (zoomable(p) ? "Click to zoom" : isClip(p) ? "Click to pause" : "");
const typeOf = (p: Pane) =>
	p.kind === "video" ? "Video" : p.kind === "slides" ? "Slides" : p.asset.kind === "clip" || p.asset.kind === "gif" ? "Clip" : "Image";
const thumbOf = (p: Pane): Asset | undefined =>
	p.kind === "visual" ? p.asset : p.kind === "video" ? (p.poster ?? p.asset) : p.slides[0];
const groups = (["About", "Media"] as const).filter((g) => panes.some((p) => p.group === g));
---

{
	panes.length > 0 && (
		<dialog class="theater" data-theater-dialog aria-label="Media viewer">
			<div class="stagebox">
				<div class="col">
					<div class="corner c-tl">
						<span class="label where">
							<span data-group /> · <span class="tabular" data-count />
						</span>
					</div>
					<div class="corner c-tr">
						<button type="button" class="close label" data-close>
							Close<span class="esc"> · Esc</span>
						</button>
					</div>
					<Screen plain class="stage">
						{panes.map((p) => (
							<div
								class:list={["pane", { zoomable: zoomable(p), clip: isClip(p) }]}
								data-pane={p.id}
								data-group={p.group}
								data-title={p.title}
								data-caption={p.caption ?? ""}
								data-shape={shape(p)}
								data-hint={hint(p)}
								hidden
							>
								{p.kind === "visual" && <Visual asset={p.asset} alt={p.alt} width={1600} fit="contain" />}
								{isClip(p) && <span class="paused label">❚❚ Paused</span>}
								{p.kind === "video" && <Player id={p.id} asset={p.asset} poster={p.poster} title={p.title} width={1600} />}
								{p.kind === "slides" && (
									<div class="slides" data-slides>
										{p.slides.map((s, n) => (
											<div class="slide" hidden={n > 0}>
												<Visual asset={s} width={1600} fit="contain" />
											</div>
										))}
										<div class="slide-bar label">
											<button type="button" data-step="-1" aria-label="Previous slide">
												‹
											</button>
											<span class="tabular" data-slide-count>
												01 / {pad(p.slides.length)}
											</span>
											<button type="button" data-step="1" aria-label="Next slide">
												›
											</button>
										</div>
										{p.pdf?.kind === "file" && (
											<a class="pdf label" href={p.pdf.src} download>
												PDF ↓
											</a>
										)}
									</div>
								)}
							</div>
						))}
					</Screen>
					<div class="corner c-bl">
						<span class="title" data-title />
						<span class="caption" data-caption />
					</div>
					<div class="corner c-br">
						{/* Always as wide as the longest hint, so the title and caption beside it never rewrap when
						    the hint changes (pause/play) or is empty */}
						<span class="hint-box">
							<span class="label hint" data-hint />
							<span class="label hint sizer" aria-hidden="true">Click to pause</span>
						</span>
					</div>
				</div>
			</div>
			<div class="strip">
				{groups.map((g) => (
					<div class="group">
						<span class="label group-label">{g}</span>
						<div class="thumbs">
							{panes
								.filter((p) => p.group === g)
								.map((p) => {
									const t = thumbOf(p);
									return (
										<button type="button" class="thumb" data-go={p.id} aria-label={p.title}>
											<Screen plain class="thumb-screen">
												{t && t.kind === "clip" ? <video src={t.src} muted preload="metadata" /> : t && <Visual asset={t} width={240} />}
											</Screen>
											<span class="badge label">{typeOf(p)}</span>
										</button>
									);
								})}
						</div>
					</div>
				))}
			</div>
		</dialog>
	)
}

<style>
	.theater {
		width: 100vw;
		height: 100vh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: rgb(11 14 20 / 0.94);
		grid-template-rows: 1fr auto;
		justify-items: center;
	}

	.theater[open] {
		display: grid;
	}

	.theater::backdrop {
		background: transparent;
	}

	/* The page underneath never scrolls while the theater is open (a wheel over the backdrop would) */
	:global(html:has(.theater[open])) {
		overflow: hidden;
	}

	/* The area above the strip. The screen is sized from its height (container units), so it always
	   leaves room for the strip, one row of groups or two, and for its own labels (--labels: the room
	   the counter and Close take above it and the title and caption below). The screen keeps its top
	   edge from item to item. */
	.stagebox {
		--labels: 9rem;
		container-type: size;
		display: grid;
		place-items: start center;
		width: 100%;
		min-height: 0;
		padding-top: 3.5rem;
	}

	/* Two shapes: landscape 16:9, portrait 3:4, each as large as the window allows. The corners share
	   the screen's edges. */
	.col {
		--ar: 16 / 9;
		position: relative;
		display: grid;
		grid-template-columns: 1fr auto;
		grid-template-areas: "tl tr" "s s" "bl br";
		align-items: end;
		column-gap: 1.5rem;
		width: min(1180px, 90vw, calc((100cqh - var(--labels)) * 16 / 9));
	}

	/* Narrow screens wrap their title and caption onto more lines: more room for the labels */
	:global(.theater:is([data-shape="portrait"], [data-shape="tall"])) .stagebox {
		--labels: 12.5rem;
	}

	:global(.theater[data-shape="portrait"]) .col {
		--ar: 3 / 4;
		width: min(90vw, calc((100cqh - var(--labels)) * 3 / 4));
	}

	:global(.theater[data-shape="tall"]) .col {
		--ar: 9 / 16;
		width: min(90vw, calc((100cqh - var(--labels)) * 9 / 16));
	}

	.col > :global(.stage) {
		grid-area: s;
		--screen-cut: 1.1rem;
		--bezel-pad: 0.55rem;
	}

	.col :global(.stage .screen) {
		aspect-ratio: var(--ar);
	}

	.corner {
		display: grid;
		gap: 0.4rem;
		min-width: 0;
	}

	.c-tl {
		grid-area: tl;
		padding-bottom: 0.9rem;
	}

	.c-tr {
		grid-area: tr;
		justify-self: end;
		padding-bottom: 0.9rem;
	}

	.c-bl {
		grid-area: bl;
		align-self: start;
		padding-top: 1rem;
	}

	.c-br {
		grid-area: br;
		align-self: start;
		justify-self: end;
		padding-top: 1rem;
	}

	.where,
	.hint {
		white-space: nowrap;
	}

	.hint-box {
		display: grid;
		justify-items: end;
	}

	.hint-box > * {
		grid-area: 1 / 1;
	}

	.sizer {
		visibility: hidden;
	}

	.close {
		all: unset;
		cursor: pointer;
		color: var(--muted);
		/* .label's type, which all: unset clears */
		font-family: var(--font-label);
		font-size: var(--text-xs);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
	}

	.close:hover,
	.close:focus-visible {
		color: var(--text);
	}

	.title {
		color: var(--text);
		font-family: var(--font-label);
		font-size: var(--text-sm);
		font-weight: 700;
		letter-spacing: var(--tracking-title);
		text-transform: uppercase;
	}

	/* At most two lines of title and three of caption, so the labels never outgrow their room */
	.title,
	.caption {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.title {
		-webkit-line-clamp: 2;
		line-clamp: 2;
	}

	.caption {
		-webkit-line-clamp: 3;
		line-clamp: 3;
		color: var(--muted);
		font-size: 0.875rem;
		line-height: 1.6;
	}

	.caption:empty {
		display: none;
	}

	.pane,
	.slide {
		position: absolute;
		inset: 0;
	}

	/* With a mouse, a still image zooms 2x where it's clicked and follows the pointer */
	.zoomable {
		transition: scale 0.25s ease-out;
	}

	@media (pointer: fine) {
		.zoomable {
			cursor: zoom-in;
		}

		:global(.theater.zoomed) .zoomable:not([hidden]) {
			scale: 2;
			cursor: zoom-out;
		}
	}

	/* A paused clip says so, over its middle */
	.paused {
		display: none;
		position: absolute;
		left: 50%;
		top: 50%;
		z-index: 2;
		translate: -50% -50%;
		padding: 0.45rem 0.9rem;
		background: color-mix(in srgb, var(--bg) 80%, transparent);
		border: 1px solid var(--muted);
		color: var(--text);
	}

	.clip:global(.is-paused) .paused {
		display: block;
	}

	.clip {
		cursor: pointer;
	}

	.slide-bar {
		position: absolute;
		left: 1rem;
		bottom: 0.85rem;
		z-index: 2;
		display: flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.15rem 0.3rem;
		background: color-mix(in srgb, var(--bg) 75%, transparent);
		border: 1px solid var(--border);
		color: var(--text);
		font-size: 0.65rem;
	}

	.slide-bar button {
		all: unset;
		cursor: pointer;
		padding: 0 0.5rem;
		font-size: 1rem;
		line-height: 1.3;
		color: var(--text);
	}

	.slide-bar button:focus-visible {
		outline: 2px solid var(--accent);
	}

	.pdf {
		position: absolute;
		right: 1rem;
		bottom: 0.85rem;
		z-index: 2;
		padding: 0.3rem 0.6rem;
		background: color-mix(in srgb, var(--bg) 75%, transparent);
		border: 1px solid var(--border);
		color: var(--text);
		font-size: 0.65rem;
	}

	.pdf:hover {
		border-color: var(--muted);
		text-decoration: none;
	}

	/* The strip: centered in the window, in the same place for every item; About figures, then Media */
	/* safe center: when the groups are wider than the window they start at its left edge instead of being
	   cut off at both ends; each group's row then shrinks and scrolls (the current one scrolls into view) */
	.strip {
		display: flex;
		justify-content: safe center;
		gap: 2.25rem;
		width: 100%;
		max-width: 100vw;
		padding: 1.25rem 1rem 1.75rem;
	}

	.group {
		display: grid;
		flex: 0 1 auto;
		gap: 0.5rem;
		min-width: 0;
	}

	/* When About and Media don't both fit side by side, they stack, as on phones (theater.ts decides) */
	.theater:global(.stacked) .strip {
		flex-direction: column;
		align-items: center;
		gap: 0.9rem;
		padding-top: 1rem;
	}

	.theater:global(.stacked) .group {
		max-width: 100%;
	}

	/* Two rows take height from the screen, so stacked thumbnails are the phones' smaller size */
	.theater:global(.stacked) .thumb {
		width: 5.25rem;
	}

	.group-label {
		font-size: 0.58rem;
	}

	.thumbs {
		display: flex;
		gap: 0.6rem;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.thumb {
		all: unset;
		position: relative;
		flex: none;
		cursor: pointer;
		width: 6.5rem;
		opacity: 0.5;
		transition: opacity 0.15s;
	}

	.thumb:is(:hover, :focus-visible, .on) {
		opacity: 1;
	}

	.thumb :global(.thumb-screen) {
		--screen-cut: 0.4rem;
		--bezel-pad: 0.2rem;
	}

	.thumb :global(.thumb-screen .screen) {
		aspect-ratio: 16 / 10;
	}

	.thumb :global(:is(img, video)) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.thumb:global(.on) :global(.viewport) {
		background: var(--accent);
	}

	/* What each thumbnail is: Image, Clip, Video, Slides */
	.badge {
		position: absolute;
		right: 0.3rem;
		bottom: 0.25rem;
		z-index: 2;
		padding: 0 0.3rem;
		background: color-mix(in srgb, var(--bg) 75%, transparent);
		color: var(--text);
		font-size: 0.5rem;
	}

	/* No Esc key on a touch screen */
	@media (pointer: coarse) {
		.esc {
			display: none;
		}
	}

	/* Phones: the screen fills the width and stays centered (the labels sit outside its box, so a caption
	   never moves it); no zoom hint; a solid backdrop; the strip's groups stacked, each scrolling sideways */
	@media (max-width: 40rem) {
		.theater {
			background: var(--bg);
		}

		.stagebox,
		:global(.theater:is([data-shape="portrait"], [data-shape="tall"])) .stagebox {
			--labels: 13rem; /* centered: room above and below alike */
			place-items: center;
			padding-top: 1rem;
		}

		.col {
			display: block;
			width: min(calc(100vw - 2rem), calc((100cqh - var(--labels)) * 16 / 9));
		}

		:global(.theater[data-shape="portrait"]) .col {
			width: min(calc(100vw - 2rem), calc((100cqh - var(--labels)) * 3 / 4));
		}

		:global(.theater[data-shape="tall"]) .col {
			width: min(calc(100vw - 2rem), calc((100cqh - var(--labels)) * 9 / 16));
		}

		.col > :global(.stage) {
			--screen-cut: 0.8rem;
			--bezel-pad: 0.4rem;
		}

		.c-tl,
		.c-tr {
			position: absolute;
			bottom: 100%;
			padding-bottom: 0.75rem;
		}

		.c-tl {
			left: 0;
		}

		.c-tr {
			right: 0;
		}

		.c-bl {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
		}

		.c-br {
			display: none;
		}

		.caption {
			font-size: 0.8125rem;
		}

		.strip {
			flex-direction: column;
			gap: 0.9rem;
			width: 100%;
			padding: 0.75rem 0 1.25rem;
		}

		.group-label {
			padding-left: 1rem;
		}

		/* Each row swipes sideways on its own, with the elastic bounce at its ends (the stage's own swipe,
		   which moves between items, is only on the screen) */
		.thumbs {
			padding: 0.2rem 1rem;
			scroll-padding-inline: 1rem;
			touch-action: pan-x;
			overscroll-behavior-x: auto;
			-webkit-overflow-scrolling: touch;
		}

		.thumb {
			width: 5.25rem;
		}
	}
</style>
