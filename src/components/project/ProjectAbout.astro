---
/*
 * A project's About: the statement (its *phrase* in amber), then the write-up's sections, each heading
 * in a label column beside its text and figures (src/scripts/project-files.ts splits the Markdown). A
 * section's first paragraph is its takeaway, in the home About lead's Space Mono, with the heading level
 * with it; the rest is dim, so heading > takeaway > detail (matching About.astro).
 */
import SectionHeading from "../SectionHeading.astro";
import Prose from "../Prose.astro";
import FigureRow from "./FigureRow.astro";
import type { Section } from "../../scripts/project-files";
import { statementHtml } from "../../scripts/markdown";

interface Props {
	statement?: string;
	sections: Section[];
}

const { statement, sections } = Astro.props;
---

{
	(statement || sections.length > 0) && (
		<section class="about" aria-labelledby="about-heading">
			<SectionHeading id="about-heading" text="About" />
			{statement && <p class="statement" set:html={statementHtml(statement)} />}
			<div class="sections">
				{sections.map((s) => (
					<>
						{s.heading && <h3 class="prompt">{s.heading}</h3>}
						<div class="body">
							{s.blocks.map((b) => (b.kind === "text" ? <Prose class="project-prose" html={b.html} /> : <FigureRow figures={b.figures} />))}
						</div>
					</>
				))}
			</div>
		</section>
	)
}

<style>
	.statement {
		max-width: 44rem;
		margin-bottom: 3.5rem;
		font-family: var(--font-label);
		font-size: 1.2rem;
		line-height: 1.45;
		letter-spacing: -0.01em;
		color: var(--text);
	}

	.statement :global(em) {
		font-style: normal;
		color: var(--accent);
	}

	.statement :global(.nowrap) {
		white-space: nowrap;
	}

	/* Headings in a label column beside their sections, with plenty of air between sections */
	.sections {
		--prompt-size: 0.875rem;
		--takeaway-size: 1.05rem;
		--takeaway-leading: 1.6;
		display: grid;
		grid-template-columns: 13rem minmax(0, 1fr);
		counter-reset: figure; /* the figures' numbers (FigureRow) */
		column-gap: 3rem;
		row-gap: 5rem;
	}

	/* Level with the middle of the takeaway's first line */
	.prompt {
		grid-column: 1;
		padding-top: calc((var(--takeaway-size) * var(--takeaway-leading) - var(--prompt-size) * 1.6) / 2);
		font-family: "Red Hat Mono", monospace;
		font-size: var(--prompt-size);
		font-weight: 300;
		line-height: 1.6;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text);
	}

	/* min-width 0 all the way down, so a long line of code scrolls inside its block instead of
	   widening the column */
	.body {
		grid-column: 2;
		display: grid;
		gap: 1.25rem;
		min-width: 0;
		max-width: 44rem;
	}

	.body > :global(.project-prose) {
		min-width: 0;
		color: #7c8494;
	}

	/* Figures get more room than paragraphs, a little more below for the caption's plate, so each
	   reads as a break in the text */
	.body > :global(.figures) {
		margin-block: 1.75rem 2.25rem;
	}

	.body > :global(.figures:last-child) {
		margin-bottom: 0;
	}

	/* The takeaway, and the detail close under it */
	.body > :global(.project-prose:first-child > p:first-child) {
		margin-bottom: 1.25rem;
		font-family: var(--font-label);
		font-size: var(--takeaway-size);
		line-height: var(--takeaway-leading);
		letter-spacing: -0.01em;
		color: var(--text);
	}

	.body > :global(.project-prose:first-child > p:first-child strong) {
		font-weight: 700;
		color: inherit;
	}

	.body > :global(.project-prose:first-child > p:first-child + *) {
		margin-top: 0;
	}

	@media (max-width: 47.99rem) {
		.sections {
			grid-template-columns: minmax(0, 1fr);
			row-gap: 0;
		}

		.prompt,
		.body {
			grid-column: 1;
		}

		.prompt {
			margin: 3.5rem 0 0.75rem;
			padding: 0;
		}

		.prompt:first-child {
			margin-top: 0;
		}
	}
</style>
