---
/*
 * A project's Media section, with no heading (the hook above leads into it): its highlights
 * (ProjectHighlights; each opens the theater), then the links as full-width bars, one to a row, each
 * opening a new tab (a report, a talk). A live site is left out: it's a button in the hero. A highlighted video's player waits here, out of sight, for the theater to
 * carry it in (Theater.astro).
 */
import ExternalIcon from "../ExternalIcon.astro";
import Player from "./Player.astro";
import ProjectHighlights from "./ProjectHighlights.astro";
import type { Highlight, MediaItem } from "../../scripts/project-files";

interface Props {
	highlights?: Highlight[];
	items: MediaItem[];
}

const { highlights = [], items } = Astro.props;
const picked = new Set(highlights.map((h) => h.id));
const videos = items.flatMap((it) => (it.type === "video" && picked.has(it.id) ? [it] : []));
const rows = items.flatMap((it) => (it.type === "link" && !it.live ? [it] : []));
---

{
	(highlights.length > 0 || rows.length > 0) && (
		<section class="media" aria-label="Media">
			<ProjectHighlights highlights={highlights} />
			{videos.map((it) => (
				<div class="player-home" hidden>
					<Player id={it.id} asset={it.asset} poster={it.poster} title={it.title} width={1200} sound={it.sound} />
				</div>
			))}
			{rows.length > 0 && (
				<ul class="rows">
					{rows.map((it) => (
						<li>
							<a href={it.href} target="_blank" rel="noopener" class:list={{ missing: !it.href }}>
								<span class="tag label">{it.tab}</span>
								<span class="name">{it.title}</span>
								<span class="go label">
									{it.href ? (
										<>
											<span class="open-word">Open</span> <ExternalIcon />
										</>
									) : (
										"Missing file"
									)}
								</span>
							</a>
						</li>
					))}
				</ul>
			)}
		</section>
	)
}

<style>
	/* One to a row, the screens' full width */
	.rows {
		display: grid;
		grid-auto-rows: 1fr;
		gap: 0.75rem;
		margin: 2.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	/* Without highlights, at the top */
	.rows:first-child {
		margin-top: 0;
	}

	.rows li {
		display: grid;
	}

	.rows a {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		gap: 1.5rem;
		align-items: center;
		padding: 1rem 1.5rem;
		border: var(--border-width) solid var(--border);
		color: var(--text);
	}

	.rows a:hover {
		border-color: var(--muted);
		text-decoration: none;
	}

	.rows a.missing {
		border-style: dashed;
		pointer-events: none;
	}

	.tag {
		padding: 0.1rem 0.45rem;
		border: var(--border-width) solid var(--border);
	}

	/* One line; a name too long for it ends in "…" */
	.name {
		overflow: hidden;
		font-family: var(--font-label);
		font-size: var(--text-sm);
		text-transform: uppercase;
		letter-spacing: var(--tracking-title);
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	.go {
		color: var(--accent);
	}

	/* Phones: tighter, the arrow alone saying it opens (more room for the name) */
	@media (max-width: 39.99rem) {
		.open-word {
			display: none;
		}
	}

	@media (max-width: 47.99rem) {
		.rows a {
			gap: 1rem;
			padding-inline: 1rem;
		}
	}
</style>
