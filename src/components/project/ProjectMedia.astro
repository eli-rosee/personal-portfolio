---
/*
 * A project's Media section: one console card per item, two columns (`wide: true` spans both; an image
 * or clip card with `shape: portrait` is one column wide and two rows tall, packed in beside others). The
 * screens show the media as it is unless `effects: true` (the grade and glass). A video plays on its card (its bar's bracket icon
 * opens the theater); images, clips and slides open in the theater. Links are bars under the cards, all one
 * height, each opening a new tab (a report, a paper); a live site comes first, the same but for a green
 * Live light in its tag and its address beside the title (it's also a button in the hero).
 */
import ConsoleCard from "../ConsoleCard.astro";
import SectionHeading from "../SectionHeading.astro";
import ExternalIcon from "../ExternalIcon.astro";
import Visual from "./Visual.astro";
import Player from "./Player.astro";
import type { MediaItem } from "../../scripts/project-files";

interface Props {
	items: MediaItem[];
}

const { items } = Astro.props;
const cards = items.flatMap((it) => (it.type === "link" ? [] : [it]));
const rows = items.flatMap((it) => (it.type === "link" ? [it] : [])).sort((a, b) => Number(b.live) - Number(a.live));
const slideCount = (n: number) => String(n).padStart(2, "0");
---

{
	items.length > 0 && (
		<section class="media" aria-labelledby="media-heading">
			<SectionHeading id="media-heading" text="Media" />
			{cards.length > 0 && (
				<div class="grid">
					{cards.map((it) => (
						<ConsoleCard
							class:list={["media-card", { wide: it.wide, portrait: (it.type === "image" || it.type === "clip") && it.shape === "portrait" }]}
							title={it.title}
							summary={it.caption}
							status={{ label: it.tab, tone: "muted" }}
							plain={!it.effects}
						>
							<div class="frame">
								{it.type === "image" && (
									<Visual
										asset={it.asset}
										alt={it.alt}
										width={it.wide ? 1200 : 640}
										fit={it.fit === "whole" ? "contain" : "cover"}
										position={it.position}
										zoom={it.zoom}
									/>
								)}
								{it.type === "clip" && <Visual asset={it.asset} />}
								{/* The poster stays on the card while its player is in the theater */}
								{it.type === "video" && it.poster && <Visual asset={it.poster} width={it.wide ? 1200 : 640} />}
								{it.type === "video" && (
									<Player id={it.id} asset={it.asset} poster={it.poster} title={it.title} width={it.wide ? 1200 : 640} fit="cover" expand meta sound={it.sound} />
								)}
								{it.type === "slides" && <Visual asset={it.slides[0]} width={it.wide ? 1200 : 640} />}
								{it.type === "slides" && <span class="meta label">01 / {slideCount(it.slides.length)}</span>}
								{it.type !== "video" && (
									<button type="button" class="open" data-theater={it.id} aria-label={`Open ${it.title} larger`} />
								)}
							</div>
						</ConsoleCard>
					))}
				</div>
			)}
			{rows.length > 0 && (
				<ul class="rows">
					{rows.map((it) => (
						<li>
							<a href={it.href} target="_blank" rel="noopener" class:list={{ missing: !it.href, live: it.live }}>
								<span class="tag label">
									{it.live && <span class="light" aria-hidden="true" />}
									{it.tab}
								</span>
								<span class="name">
									{it.title}
									{it.address && <span class="address">{it.address}</span>}
								</span>
								<span class="go label">
									{it.href ? (
										<>
											Open <ExternalIcon />
										</>
									) : (
										"Missing file"
									)}
								</span>
							</a>
						</li>
					))}
				</ul>
			)}
		</section>
	)
}

<style>
	/* dense: a portrait card's neighbours fill in beside it */
	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		grid-auto-flow: row dense;
		gap: 2.5rem 2rem;
	}

	.grid > :global(.wide) {
		grid-column: 1 / -1;
	}

	/* A portrait card: two rows tall, its screen taking the height its text leaves */
	.grid > :global(.portrait) {
		grid-row: span 2;
	}

	.grid > :global(.portrait .viewport) {
		flex: 1 1 0;
		min-height: 0;
	}

	.grid > :global(.portrait .text) {
		flex-grow: 0;
	}

	.grid > :global(.portrait :is(.bezel, .rim, .screen)) {
		height: 100%;
	}

	.grid > :global(.portrait) .frame {
		aspect-ratio: auto;
		height: 100%;
	}

	.frame {
		position: relative;
		aspect-ratio: 16 / 9;
	}

	/* The whole screen opens the theater; the zoom cursor says so */
	.open {
		all: unset;
		position: absolute;
		inset: 0;
		z-index: 4; /* over the card's own link layer */
		cursor: zoom-in;
	}

	.open:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: -4px;
	}

	.meta {
		position: absolute;
		right: 1rem;
		bottom: 0.85rem;
		z-index: 2;
		padding: 0.1rem 0.45rem;
		background: color-mix(in srgb, var(--bg) 70%, transparent);
		font-size: 0.6rem;
	}


	.rows {
		display: grid;
		grid-auto-rows: 1fr;
		gap: 0.75rem;
		margin: 2.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	.rows li {
		display: grid;
	}

	.rows a {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		gap: 1.5rem;
		align-items: center;
		padding: 1rem 1.5rem;
		border: 1px solid var(--border);
		color: var(--text);
	}

	.rows a:hover {
		border-color: var(--muted);
		text-decoration: none;
	}

	.rows a.missing {
		border-style: dashed;
		pointer-events: none;
	}

	.tag {
		padding: 0.1rem 0.45rem;
		border: 1px solid var(--border);
	}

	/* A live site: the same bar, with a green light in its tag (the status color, kept for "live") */
	.live .tag {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		border-color: color-mix(in srgb, var(--status) 45%, transparent);
		color: var(--status);
	}

	/* Hidden on phones, where the bar is too narrow for it */
	.address {
		margin-left: 1.25rem;
		color: var(--muted);
		font-family: var(--font-body);
		font-size: 0.8125rem;
		letter-spacing: 0;
		text-transform: none;
	}

	.name {
		font-family: var(--font-label);
		font-size: var(--text-sm);
		text-transform: uppercase;
		letter-spacing: var(--tracking-title);
	}

	.go {
		color: var(--accent);
	}

	/* Phones: one column; a portrait card is simply 3:4; the bars tighter */
	@media (max-width: 47.99rem) {
		.rows a {
			gap: 1rem;
			padding-inline: 1rem;
		}

		.address {
			display: none;
		}


		.grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.grid > :global(.portrait) {
			grid-row: auto;
		}

		.grid > :global(.portrait .viewport) {
			flex: none;
		}

		.grid > :global(.portrait :is(.bezel, .rim, .screen)) {
			height: auto;
		}

		.grid > :global(.portrait) .frame {
			aspect-ratio: 3 / 4;
			height: auto;
		}
	}
</style>
