---
/*
 * Figures in a project's write-up: one, or two or three side by side. Each takes one of two shapes from
 * its image: landscape (16:9), portrait (3:4) or square (1:1), filled (the edges cut if its shape is in between). Side by
 * side they share one height. Each is a plain screen (the grade and glass only with {effects=true}) with its caption on a plate
 * under it, joined to the screen by a leader line and numbered (Fig 01, counted in ProjectAbout), and opens in the theater (the
 * zoom cursor says so). A clip with {values=N} gets a progress bar along its bottom and a count of its N
 * values climbing as it plays (src/scripts/clip-hud.ts).
 */
import Screen from "../Screen.astro";
import Visual from "./Visual.astro";
import { shapeOf, type Figure } from "../../scripts/project-files";

interface Props {
	figures: Figure[];
}

const { figures } = Astro.props;
const ratio = { landscape: 16 / 9, portrait: 3 / 4, square: 1 };
const single = figures.length === 1;
---

<div class:list={["figures", { single }]}>
	{
		figures.map((f) => {
			const shape = shapeOf(f.asset);
			return (
				<figure class:list={["figure", shape]} style={`--ar: ${ratio[shape].toFixed(4)}`}>
					<button type="button" class="open" data-theater={f.id} aria-label={`Open ${f.caption ?? f.alt ?? "figure"} larger`}>
						<Screen plain={!f.effects} class="figure-screen">
							<div class="frame">
								<Visual asset={f.asset} alt={f.alt} width={single ? 900 : 600} />
								{f.values && f.asset.kind === "clip" && (
									<div class="clip-hud" data-values={f.values} aria-hidden="true">
										<span class="label chip count">
											<span class="dim">Values</span> <span class="n">0</span> <span class="dim">/ {f.values.toLocaleString("en-US")}</span>
										</span>
										<span class="bar"><span class="fill" /></span>
									</div>
								)}
							</div>
						</Screen>
					</button>
					{f.caption && <figcaption class="label"><span>{f.caption}</span></figcaption>}
				</figure>
			);
		})
	}
</div>

<style>
	/* Side by side at one height: each figure's share of the row is its shape's width */
	.figures {
		display: flex;
		gap: 1.25rem;
		align-items: flex-start;
	}

	.figure {
		flex: var(--ar) 1 0;
		min-width: 0;
		margin: 0;
	}

	/* One portrait figure on its own stays narrow, so it doesn't run down the page */
	.single .figure.portrait {
		flex: none;
		width: min(100%, 22rem);
	}

	.open {
		all: unset;
		display: block;
		width: 100%;
		cursor: zoom-in;
	}

	.open:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	.figures :global(.figure-screen) {
		--screen-cut: 0.9rem;
		--bezel-pad: 0.45rem;
	}

	.figures:not(.single) :global(.figure-screen) {
		--screen-cut: 0.7rem;
		--bezel-pad: 0.35rem;
	}

	.frame {
		position: relative;
		aspect-ratio: var(--ar);
	}

	/* A clip's progress: the values passed in a chip at the top right, an amber bar along the bottom. Over
	   the footage, so they keep a dark backing whatever the clip shows. */
	.clip-hud {
		--chip: rgb(11 14 20 / 0.82);
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.chip {
		position: absolute;
		top: 0.75rem;
		padding: 0.35rem 0.6rem;
		background: var(--chip);
		border: 1px solid var(--frame-line-lit);
		color: var(--text);
		font-variant-numeric: tabular-nums;
	}

	.count {
		right: 0.75rem;
	}

	/* Phones: a smaller chip, so it covers less of a small screen */
	@media (max-width: 35.99rem) {
		.chip {
			top: 0.45rem;
			padding: 0.25rem 0.45rem;
			font-size: 0.58rem;
		}

		.count {
			right: 0.45rem;
		}

		.bar {
			height: 4px;
		}
	}

	.count .dim {
		color: var(--muted);
	}

	.count .n {
		color: var(--accent);
	}

	.bar {
		position: absolute;
		inset: auto 0 0;
		height: 6px;
		background: rgb(11 14 20 / 0.85);
	}

	/* Scaled rather than resized, so it moves on the compositor */
	.fill {
		display: block;
		height: 100%;
		background: var(--accent);
		transform-origin: left;
		scale: var(--progress, 0) 1;
	}

	/* The caption's plate, with a leader line dropping into it from the screen. Too long for one line, the
	   number goes on a line of its own first (flex wrap), then the caption wraps. */
	figcaption {
		--leader-gap: 0.9rem;
		position: relative;
		display: flex;
		flex-wrap: wrap;
		column-gap: 1.1em;
		width: fit-content;
		max-width: calc(100% - 2.4rem);
		margin: var(--leader-gap) 0 0 2.4rem;
		padding: 0.35em 1.15em;
		border: 1px solid var(--frame-line-lit);
		font-size: 0.8125rem;
		line-height: 1.5;
		letter-spacing: 0.16em;
		color: var(--text);
		counter-increment: figure;
	}

	.figures:not(.single) figcaption {
		letter-spacing: 0.1em;
	}

	figcaption::before {
		content: "Fig " counter(figure, decimal-leading-zero);
		white-space: nowrap;
		color: var(--muted);
	}

	figcaption::after {
		content: "";
		position: absolute;
		right: calc(100% + 1px);
		bottom: 50%;
		width: 1.1rem;
		height: calc(50% + var(--leader-gap) + 1px);
		border-left: 1px solid var(--frame-line-lit);
		border-bottom: 1px solid var(--frame-line-lit);
	}

	@media (max-width: 35.99rem) {
		.figures {
			flex-direction: column;
		}

		.figure,
		.single .figure:is(.portrait, .square) {
			flex: none;
			width: 100%;
		}
	}
</style>
