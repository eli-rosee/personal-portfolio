---
import { Image } from "astro:assets";
import { site } from "../data/site";
import wordmark from "../assets/wordmark.png";
---

<section class="hero">
	<p class="label callsign">
		<span>{site.callsign}</span>
		<span aria-hidden="true">·</span>
		<span class="tabular" data-mission-clock>T+ 00:00:00</span>
	</p>

	<h1>
		<Image
			src={wordmark}
			alt={site.name}
			width={700}
			densities={[1, 2]}
			loading="eager"
			fetchpriority="high"
		/>
	</h1>

	<p class="tagline">{site.tagline}</p>

	<div class="actions">
		<a class="button primary" href={site.resume} target="_blank" rel="noopener">
			Resume (PDF)
		</a>
		<a class="button" href={site.github} target="_blank" rel="noopener">GitHub</a>
		<!-- Copies the address on desktop. On phones, or without JavaScript, it opens the mail app. -->
		<a class="button copy-email" href={`mailto:${site.email}`} data-email={site.email}>
			<span class="copy-label">Email</span>
			<span class="copy-label copied" aria-hidden="true">Copied</span>
		</a>
		<p class="copy-status sr-only" role="status" aria-live="polite"></p>
	</div>
</section>

<script>
	// T+ mission clock: time since the page opened. Without JavaScript it stays at 00:00:00.
	const clock = document.querySelector<HTMLElement>("[data-mission-clock]");
	if (clock) {
		const pad = (n: number) => String(n).padStart(2, "0");
		const tick = () => {
			const s = Math.floor(performance.now() / 1000);
			clock.textContent = `T+ ${pad(Math.floor(s / 3600))}:${pad(Math.floor(s / 60) % 60)}:${pad(s % 60)}`;
		};
		tick();
		setInterval(tick, 250); // checks often so seconds never visibly skip
	}
</script>

<script>
	const button = document.querySelector<HTMLAnchorElement>(".copy-email");
	const status = document.querySelector<HTMLElement>(".copy-status");
	let resetTimer: number | undefined;

	button?.addEventListener("click", async (event) => {
		const email = button.dataset.email;
		// Touch devices (no hover) keep the normal mailto link and open the mail app
		const isTouch = window.matchMedia("(hover: none)").matches;
		if (!email || !navigator.clipboard || isTouch) return;

		event.preventDefault();
		try {
			await navigator.clipboard.writeText(email);
		} catch {
			window.location.href = button.href; // copy blocked: fall back to mailto
			return;
		}

		button.classList.add("is-copied");
		if (status) status.textContent = `Copied ${email} to clipboard`;
		clearTimeout(resetTimer);
		resetTimer = window.setTimeout(() => {
			button.classList.remove("is-copied");
			if (status) status.textContent = "";
		}, 2000);
	});
</script>

<style>
	.hero {
		max-width: var(--page-max);
		margin: 0 auto;
		padding: clamp(var(--space-4), 8vw, var(--space-12)) var(--gutter)
			clamp(var(--space-3), 6vw, var(--space-8));
	}

	.callsign {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.5em;
		white-space: nowrap;
		margin-bottom: var(--space-2);
	}

	h1 img {
		width: min(700px, 100%);
	}

	.tagline {
		max-width: 38rem;
		margin-top: var(--space-4);
		font-size: var(--text-lg);
		line-height: 1.8;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-6);
	}

	.button {
		display: inline-block;
		padding: 0.9rem 1.75rem;
		border: var(--border-width) solid var(--border);
		color: var(--text);
		font-family: var(--font-label);
		font-size: var(--text-sm);
		font-weight: 700;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
	}

	.button:hover {
		border-color: var(--muted);
		text-decoration: none;
	}

	/* Both labels share one grid cell so the button keeps its width when swapping */
	.copy-email {
		display: inline-grid;
	}

	.copy-label {
		grid-area: 1 / 1;
		text-align: center;
	}

	.copy-label.copied,
	.copy-email.is-copied .copy-label:not(.copied) {
		visibility: hidden;
	}

	.copy-email.is-copied {
		border-color: var(--status);
	}

	.copy-email.is-copied .copied {
		visibility: visible;
		color: var(--status);
	}

	/* Phones: Resume full width, GitHub and Email side by side */
	@media (max-width: 30rem) {
		.actions {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: var(--space-1);
			margin-top: var(--space-4);
		}

		.button {
			padding-inline: var(--space-1);
			text-align: center;
		}

		.button.primary {
			grid-column: 1 / -1;
		}

		.tagline {
			margin-top: var(--space-3);
			font-size: var(--text-base);
		}
	}

	.button.primary {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--bg);
	}

	.button.primary:hover {
		background: var(--text);
		border-color: var(--text);
	}
</style>
