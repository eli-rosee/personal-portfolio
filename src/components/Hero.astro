---
import { Image } from "astro:assets";
import { site } from "../data/site";
import wordmark from "../assets/wordmark.png";
import CopyEmail from "./CopyEmail.astro";
---

<section class="hero">
	<p class="label callsign">
		<span>{site.callsign}</span>
		<span aria-hidden="true">·</span>
		<span class="tabular" data-mission-clock>T+ 00:00:00</span>
	</p>

	<h1>
		<Image
			src={wordmark}
			alt={site.name}
			width={700}
			densities={[1, 2]}
			loading="eager"
			fetchpriority="high"
		/>
	</h1>

	<p class="tagline">{site.tagline}</p>

	<div class="actions">
		<a class="button primary" href={site.resume} target="_blank" rel="noopener">
			Resume (PDF)
		</a>
		<a class="button" href={site.github} target="_blank" rel="noopener">GitHub</a>
		<CopyEmail class="button" label="Email" />
	</div>
</section>

<script>
	// T+ mission clock: time since the page opened. Without JavaScript it stays at 00:00:00.
	const clock = document.querySelector<HTMLElement>("[data-mission-clock]");
	if (clock) {
		const pad = (n: number) => String(n).padStart(2, "0");
		const tick = () => {
			const s = Math.floor(performance.now() / 1000);
			clock.textContent = `T+ ${pad(Math.floor(s / 3600))}:${pad(Math.floor(s / 60) % 60)}:${pad(s % 60)}`;
		};
		tick();
		setInterval(tick, 250); // checks often so seconds never visibly skip
	}
</script>

<style>
	.hero {
		max-width: var(--page-max);
		margin: 0 auto;
		padding: clamp(var(--space-4), 8vw, var(--space-12)) var(--gutter)
			clamp(var(--space-3), 6vw, var(--space-8));
	}

	.callsign {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.5em;
		white-space: nowrap;
		margin-bottom: var(--space-2);
	}

	h1 img {
		width: min(700px, 100%);
	}

	.tagline {
		max-width: 38rem;
		margin-top: var(--space-4);
		font-size: var(--text-lg);
		line-height: 1.8;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-6);
	}

	.button {
		display: inline-block;
		padding: 0.9rem 1.75rem;
		border: var(--border-width) solid var(--border);
		color: var(--text);
		font-family: var(--font-label);
		font-size: var(--text-sm);
		font-weight: 700;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
	}

	.button:hover {
		border-color: var(--muted);
		text-decoration: none;
	}

	/* Phones: Resume full width, GitHub and Email side by side */
	@media (max-width: 30rem) {
		.actions {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: var(--space-1);
			margin-top: var(--space-4);
		}

		.button {
			padding-inline: var(--space-1);
			text-align: center;
		}

		.button.primary {
			grid-column: 1 / -1;
		}

		.tagline {
			margin-top: var(--space-3);
			font-size: var(--text-base);
		}
	}

	.button.primary {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--bg);
	}

	.button.primary:hover {
		background: var(--text);
		border-color: var(--text);
	}
</style>
