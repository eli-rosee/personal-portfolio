---
import { Image } from "astro:assets";
import { site } from "../content/site";
import wordmark from "../assets/brand/wordmark.png";
import Button from "./Button.astro";
---

{/* Name, one line on what I do, and the three links a recruiter needs, all above the fold */}
<section class="hero">
	<h1>
		<Image
			src={wordmark}
			alt={site.name}
			width={700}
			densities={[1, 2]}
			loading="eager"
			fetchpriority="high"
		/>
	</h1>

	<p class="tagline">
		{site.tagline}
		<span class="availability">{site.availability}</span>
	</p>

	<div class="actions">
		<Button primary external href={site.resume}>Resume (PDF)</Button>
		<Button external href={site.github}>GitHub</Button>
		<Button external href={site.linkedin}>LinkedIn</Button>
	</div>
</section>

<style>
	.hero {
		max-width: var(--page-max);
		margin: 0 auto;
		padding: clamp(var(--space-6), 8vw, var(--space-12)) var(--gutter) var(--section-seam); /* clear room under the nav */
	}

	h1 img {
		width: min(700px, 100%);
	}

	.tagline {
		margin-top: var(--space-4);
		font-size: var(--text-lg);
		line-height: 1.8;
	}

	/* Its own line, quieter than the tagline */
	.availability {
		display: block;
		color: var(--muted);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-4);
	}

	/* Until all three fit on one row (they need ~36rem): Resume full width, the other links side
	   by side below it, so LinkedIn never wraps onto a row of its own */
	@media (max-width: 39.99rem) {
		.actions {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: var(--space-1);
		}

		.actions > :global(.button) {
			padding-inline: var(--space-1);
			text-align: center;
		}

		.actions > :global(.primary) {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 30rem) {
		.tagline {
			margin-top: var(--space-3);
			font-size: var(--text-base);
		}
	}
</style>
