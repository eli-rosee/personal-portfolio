---
import { Image } from "astro:assets";
import { site } from "../data/site";
import wordmark from "../assets/wordmark.png";
import ExternalIcon from "./ExternalIcon.astro";
---

<section class="hero">
	<h1>
		<Image
			src={wordmark}
			alt={site.name}
			width={700}
			densities={[1, 2]}
			loading="eager"
			fetchpriority="high"
		/>
	</h1>

	<p class="tagline">
		{site.tagline}
		<span class="availability">{site.availability}</span>
	</p>

	<div class="actions">
		<a class="button primary" href={site.resume} target="_blank" rel="noopener">
			Resume (PDF) <ExternalIcon />
		</a>
		<a class="button" href={site.github} target="_blank" rel="noopener">GitHub <ExternalIcon /></a>
		<a class="button" href={site.linkedin} target="_blank" rel="noopener">LinkedIn <ExternalIcon /></a>
	</div>
</section>

<style>
	.hero {
		max-width: var(--page-max);
		margin: 0 auto;
		padding: clamp(var(--space-6), 8vw, var(--space-12)) var(--gutter) var(--section-seam); /* clear room under the nav */
	}

	h1 img {
		width: min(700px, 100%);
	}

	.tagline {
		margin-top: var(--space-4);
		font-size: var(--text-lg);
		line-height: 1.8;
	}

	/* Its own line, quieter than the tagline */
	.availability {
		display: block;
		color: var(--muted);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-4);
	}

	.button {
		display: inline-block;
		padding: 0.9rem 1.75rem;
		border: var(--border-width) solid var(--border);
		color: var(--text);
		font-family: var(--font-label);
		font-size: var(--text-sm);
		font-weight: 700;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		white-space: nowrap; /* keeps the new-tab arrow beside its label */
	}

	/* New-tab arrow, like the nav's Resume link */
	.button :global(svg) {
		margin-left: 0.2em;
		vertical-align: 0.05em;
	}

	.button:hover {
		border-color: var(--muted);
		text-decoration: none;
	}

	/* Phones: Resume full width, the other links side by side below it */
	@media (max-width: 30rem) {
		.actions {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: var(--space-1);
		}

		.button {
			padding-inline: var(--space-1);
			text-align: center;
		}

		.button.primary {
			grid-column: 1 / -1;
		}

		.tagline {
			margin-top: var(--space-3);
			font-size: var(--text-base);
		}
	}

	.button.primary {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--bg);
	}

	.button.primary:hover {
		background: var(--text);
		border-color: var(--text);
	}
</style>
