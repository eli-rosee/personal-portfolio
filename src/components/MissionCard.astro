---
import type { CollectionEntry } from "astro:content";
import ExternalIcon from "./ExternalIcon.astro";
import { hasPage, pageUrl } from "../data/projects";

interface Props {
	project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { number, title, status, summary, stack, links } = project.data;
const statusLabel = status.replace("-", " ");

// Plain-English meaning, shown on hover, keyboard focus, or tap
const statusMeaning = {
	launched: "In active development",
	"in-orbit": "Completed",
	decommissioned: "No longer maintained",
}[status];
const tipId = `status-tip-${number}`;
// The title opens the project page if there is one, otherwise the demo or repo in a new tab
const internal = hasPage(project);
const href = internal ? pageUrl(project) : (links?.demo ?? links?.repo);
const target = internal ? {} : { target: "_blank", rel: "noopener" };

// The last word and the link arrow never wrap apart
const words = title.split(" ");
const lastWord = words.pop();
const leadingWords = words.length ? `${words.join(" ")} ` : "";
---

<article class="card">
	<header class="label">
		<span class="tabular">Mission {String(number).padStart(2, "0")}</span>
		<span class="status-wrap">
			<span class={`status ${status}`} tabindex="0" aria-describedby={tipId}>
				<span class="light" aria-hidden="true"></span>
				{statusLabel}
			</span>
			<span class="tip" id={tipId} role="tooltip">{statusMeaning}</span>
		</span>
	</header>

	<h3>
		{
			href ? (
				<a href={href} {...target}>
					{leadingWords}
					<span class="nowrap">
						{lastWord}
						<ExternalIcon />
					</span>
				</a>
			) : (
				title
			)
		}
	</h3>

	<p class="summary">{summary}</p>

	<ul class="stack label" aria-label="Tech stack">
		{stack.map((tech) => <li>{tech}</li>)}
	</ul>
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		padding: var(--space-4);
		background: var(--surface);
		border: var(--border-width) solid var(--border);
		container-type: inline-size;
	}

	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-1) var(--space-2);
	}

	.status-wrap {
		position: relative; /* anchors the tooltip to the status */
	}

	/* Indicator chip: a faint frame hints that it can be hovered or tapped */
	.status {
		display: inline-flex;
		align-items: center;
		gap: 0.6em;
		padding: 0.15rem 0.5rem;
		border: var(--border-width) solid var(--border);
		color: var(--muted);
		cursor: help;
		transition: border-color 0.15s;
	}

	.status:hover,
	.status:focus-visible {
		border-color: currentColor;
	}

	.status:focus-visible {
		outline-offset: 3px;
	}

	.light {
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 50%;
		background: currentColor;
	}

	/* Active development: the light pulses slowly, like a live signal */
	.launched .light {
		box-shadow: 0 0 0.4rem currentColor;
		animation: pulse 2.4s ease-in-out infinite;
	}

	.in-orbit .light {
		box-shadow: 0 0 0.4rem currentColor;
	}

	@keyframes pulse {
		50% {
			opacity: 0.25;
		}
	}

	.tip {
		position: absolute;
		top: calc(100% + var(--space-1));
		right: 0;
		z-index: 1;
		width: max-content; /* sized to its own text */
		max-width: 100cqi; /* card content width */
		padding: 0.3rem 0.6rem;
		line-height: 1.5;
		text-align: center;
		background: var(--bg);
		border: var(--border-width) solid var(--border);
		color: var(--text);
		letter-spacing: 0.1em;
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 0.15s,
			visibility 0.15s;
	}

	.status:hover + .tip,
	.status:focus + .tip {
		opacity: 1;
		visibility: visible;
	}

	/* Narrow cards: status goes under the mission number, tooltip opens to the right */
	@container (max-width: 17.5rem) {
		header {
			flex-direction: column;
			align-items: flex-start;
		}

		.tip {
			right: auto;
			left: 0;
		}
	}

	.status.in-orbit {
		color: var(--status);
	}

	.status.launched {
		color: var(--accent);
	}

	h3 {
		font-size: var(--text-lg);
		letter-spacing: var(--tracking-title);
		text-transform: uppercase;
	}

	h3 a {
		color: var(--text);
	}

	.nowrap {
		white-space: nowrap;
	}

	h3 a :global(svg) {
		display: inline-block;
		margin-left: 0.3em;
		vertical-align: 0.05em;
		color: var(--muted);
	}

	h3 a:hover :global(svg) {
		color: var(--accent);
	}

	.summary {
		flex-grow: 1; /* keeps stack tags aligned at the bottom across cards */
		color: var(--muted);
		font-size: 0.95rem;
		line-height: 1.8;
	}

	.stack {
		display: flex;
		flex-wrap: wrap;
		margin: 0;
		padding: 0;
		list-style: none;
		color: var(--accent);
	}

	.stack li:not(:last-child)::after {
		content: "·";
		margin: 0 1em;
	}
</style>
