---
// A project on the console card: its status in the tab, an image from the project on the screen
// ("no signal" until there is one), and the whole card linking to the project's page.
import type { CollectionEntry } from "astro:content";
import ConsoleCard from "./ConsoleCard.astro";
import ProjectDisplay from "./ProjectDisplay.astro";
import { STATUS } from "../scripts/projects";
import { display as displayOf } from "../scripts/project-files";

interface Props {
	project: CollectionEntry<"projects">;
	eager?: boolean; // load the screen image right away (cards on screen at load)
}

const { project, eager = false } = Astro.props;
const { number, title, status, summary, stack } = project.data;
const shown = displayOf(project);
---

<ConsoleCard
	title={title}
	summary={summary}
	tags={stack}
	tagsLabel="Tech stack"
	href={`/projects/${project.id}/`}
	status={{ label: status.replace("-", " "), ...STATUS[status], tipId: `status-tip-${number}` }}
	style="--summary-lines: 2"
	plain={shown?.effects === false}
>
	<ProjectDisplay display={shown} eager={eager} />
</ConsoleCard>
