---
// A project on the console card: its status in the tab, a real image from the project on the
// screen (or "no signal" until there is one), and the whole card linking to the project's page
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import ConsoleCard from "./ConsoleCard.astro";

interface Props {
	project: CollectionEntry<"projects">;
	eager?: boolean; // load the screen image right away (cards on screen at load)
}

const { project, eager = false } = Astro.props;
const { number, title, status, summary, stack, display } = project.data;

// Plain-English meaning of the status, shown on hover, keyboard focus, or tap
const tip = {
	liftoff: "In active development",
	"in-orbit": "Completed",
	decommissioned: "No longer maintained",
}[status];
const tone = ({ liftoff: "accent", "in-orbit": "status", decommissioned: "muted" } as const)[status];
---

<ConsoleCard
	title={title}
	summary={summary}
	tags={stack}
	tagsLabel="Tech stack"
	href={`/projects/${project.id}/`}
	status={{ label: status.replace("-", " "), tone, tip, tipId: `status-tip-${number}` }}
	style="--summary-lines: 2"
>
	<figure class="screen">
		{
			display ? (
				<Image
					src={display.image}
					alt={display.alt}
					widths={[400, 640, 960]}
					sizes="(max-width: 48rem) 100vw, 20rem"
					loading={eager ? "eager" : "lazy"}
					style={`object-position: ${display.position}; scale: ${display.zoom}; transform-origin: ${display.position}`}
				/>
			) : (
				<div class="no-signal" aria-hidden="true">
					<span class="crosshair" />
				</div>
			)
		}
		{
			(display?.readout || !display) && (
				<figcaption class="readout label" aria-hidden={!display}>
					{display?.readout ?? "No signal"}
				</figcaption>
			)
		}
	</figure>
</ConsoleCard>

<style>
	.screen {
		position: relative;
		margin: 0;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: var(--bg);
	}

	.screen img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Glare across the glass */
	.screen::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(135deg, rgb(255 255 255 / 0.09), transparent 32%);
		pointer-events: none;
	}

	/* Faint scanlines and a dark rim */
	.screen::after {
		content: "";
		position: absolute;
		inset: 0;
		background: repeating-linear-gradient(transparent 0 2px, rgb(0 0 0 / 0.18) 2px 3px);
		box-shadow:
			inset 0 0 0 1px var(--border),
			inset 0 0 2.5rem rgb(0 0 0 / 0.65); /* glass edge and dark rim, as on the About clip */
		pointer-events: none;
	}

	.readout {
		position: absolute;
		right: 0.9rem; /* clear of the cut corner and the dark rim */
		bottom: 0.75rem;
		z-index: 2;
		padding: 0.1rem 0.4rem;
		background: rgb(11 14 20 / 0.7);
		color: var(--muted);
		font-size: 0.6rem;
	}

	/* No image yet: faint static bands and a dim crosshair */
	.no-signal {
		position: absolute;
		inset: 0;
		background:
			repeating-linear-gradient(transparent 0 7px, rgb(138 147 166 / 0.05) 7px 9px),
			radial-gradient(circle at 50% 50%, rgb(37 44 59 / 0.9), var(--bg) 70%);
	}

	.crosshair {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 2.4rem;
		height: 2.4rem;
		translate: -50% -50%;
		border: 1px solid var(--border);
		border-radius: 50%;
		background:
			linear-gradient(var(--muted), var(--muted)) 50% 0 / 1px 30% no-repeat,
			linear-gradient(var(--muted), var(--muted)) 50% 100% / 1px 30% no-repeat,
			linear-gradient(var(--muted), var(--muted)) 0 50% / 30% 1px no-repeat,
			linear-gradient(var(--muted), var(--muted)) 100% 50% / 30% 1px no-repeat;
		opacity: 0.6;
	}
</style>
