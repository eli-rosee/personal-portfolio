---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import ExternalIcon from "./ExternalIcon.astro";

interface Props {
	project: CollectionEntry<"projects">;
	eager?: boolean; // load the screen image right away (cards on screen at load)
}

const { project, eager = false } = Astro.props;
const { number, title, status, summary, stack, display } = project.data;
const statusLabel = status.replace("-", " ");

// Plain-English meaning, shown on hover, keyboard focus, or tap
const statusMeaning = {
	liftoff: "In active development",
	"in-orbit": "Completed",
	decommissioned: "No longer maintained",
}[status];
const tipId = `status-tip-${number}`;
// Only the last word drops to a second line, so the tooltip wraps to two snug lines
const tipText = statusMeaning.replace(/ (?=.* )/g, "\u00A0");
// The title opens the project's own page (those pages are still to be built)
const href = `/projects/${project.id}/`;

---

{/*
	A console panel: a tab on top holding the status (its top edge lit in the status color), a
	viewport screen showing a real image from the project (or "no signal" until there is one),
	then the title and summary, then a separator line and the tags.
*/}
<div class:list={["panel", status]}>
	<span class="tab label">
		<span class="status" tabindex="0" aria-describedby={tipId}>
			<span class="light" aria-hidden="true"></span>
			<span class="status-text">{statusLabel}</span>
			{/* Info mark: says "there's more here". Drawn on whole pixels (1px ring, the i as 1px
			    rects) at a fixed 11px, so it stays sharp at this small size */}
			<svg class="info" width="11" height="11" viewBox="0 0 11 11" aria-hidden="true">
				<circle cx="5.5" cy="5.5" r="5" fill="none" stroke="currentColor"></circle>
				<g fill="currentColor" shape-rendering="crispEdges">
					<rect x="5" y="2.5" width="1" height="1"></rect>
					<rect x="5" y="4.5" width="1" height="4"></rect>
				</g>
			</svg>
		</span>
	</span>
	<span class="tip label" id={tipId} role="tooltip">{tipText}</span>

	<article class="card">
		<div class="viewport">
			<div class="bezel">
				<figure class="screen">
					{
						display ? (
							<Image
								src={display.image}
								alt={display.alt}
								widths={[400, 640, 960]}
								sizes="(max-width: 48rem) 100vw, 20rem"
								loading={eager ? "eager" : "lazy"}
								style={`object-position: ${display.position}; scale: ${display.zoom}; transform-origin: ${display.position}`}
							/>
						) : (
							<div class="no-signal" aria-hidden="true">
								<span class="crosshair" />
							</div>
						)
					}
					{
						(display?.readout || !display) && (
							<figcaption class="readout label" aria-hidden={!display}>
								{display?.readout ?? "No signal"}
							</figcaption>
						)
					}
				</figure>
			</div>
		</div>

		<div class="text">
			<h3>
				<a href={href}>
					<span>{title}</span>
					<ExternalIcon />
				</a>
			</h3>
			<p class="summary">{summary}</p>
		</div>

		<hr class="separator" />

		<ul class="stack label" aria-label="Tech stack">
			{stack.map((tech) => <li>{tech}</li>)}
		</ul>
	</article>
</div>

<style>
	.panel {
		--frame: 2px;
		--line: #2e3649; /* a touch lighter than --border, so the 2px frame reads */
		--tab-w: 12rem;
		--tab-h: 1.9rem;
		--slant: 0.75rem;
		/* How far the inner edge of a 2px slanted line sits from the outer one, along the top and
		   bottom of the slant (from the tab's proportions); keeps the slants as thick as the rest */
		--kink: 1.35px;
		--lit: var(--muted); /* the status color */
		--cut: 14px; /* the card's bevelled corners: top right of the body, both bottom corners */
		/* How far the inner edge of a 2px 45° line sits from the outer one, along each side */
		--cut-kink: 0.83px;
		position: relative;
		padding-top: var(--tab-h);
	}

	.panel.in-orbit {
		--lit: var(--status);
	}

	.panel.liftoff {
		--lit: var(--accent);
	}

	/*
	 * The outline, tab and card together, drawn as one shape: the frame color, with the panel color
	 * inset 2px inside it. One continuous edge, so the tab flows into the frame with the same
	 * thickness everywhere (two separate shapes rendered their joins unevenly on phones).
	 * The body's corners are bevelled like the screen's (except top left, where the tab is).
	 */
	.panel::before,
	.panel::after {
		content: "";
		position: absolute;
		inset: 0;
	}

	.panel::before {
		background: var(--line);
		clip-path: polygon(
			0 calc(100% - var(--cut)),
			0 var(--tab-h),
			var(--slant) 0,
			calc(var(--tab-w) - var(--slant)) 0,
			var(--tab-w) var(--tab-h),
			calc(100% - var(--cut)) var(--tab-h),
			100% calc(var(--tab-h) + var(--cut)),
			100% calc(100% - var(--cut)),
			calc(100% - var(--cut)) 100%,
			var(--cut) 100%
		);
	}

	.panel::after {
		background: var(--surface);
		clip-path: polygon(
			var(--frame) calc(100% - var(--cut) - var(--cut-kink)),
			var(--frame) var(--tab-h),
			calc(var(--slant) + var(--kink)) var(--frame),
			calc(var(--tab-w) - var(--slant) - var(--kink)) var(--frame),
			calc(var(--tab-w) - var(--kink)) calc(var(--tab-h) + var(--frame)),
			calc(100% - var(--cut) - var(--cut-kink)) calc(var(--tab-h) + var(--frame)),
			calc(100% - var(--frame)) calc(var(--tab-h) + var(--cut) + var(--cut-kink)),
			calc(100% - var(--frame)) calc(100% - var(--cut) - var(--cut-kink)),
			calc(100% - var(--cut) - var(--cut-kink)) calc(100% - var(--frame)),
			calc(var(--cut) + var(--cut-kink)) calc(100% - var(--frame))
		);
	}

	/* The tab's contents, over the outline */
	.tab {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		width: var(--tab-w);
		height: var(--tab-h);
		padding: var(--frame) var(--slant) 0;
		cursor: pointer; /* a pointer over the whole tab, text included; the text isn't selectable */
		user-select: none;
	}

	/* The tab's top edge, lit in the status color */
	.tab::after {
		content: "";
		position: absolute;
		top: 0;
		left: var(--slant);
		right: var(--slant);
		height: var(--frame);
		background: var(--lit);
		box-shadow: 0 0 6px var(--lit);
		opacity: 0.7; /* dimmed at rest; full brightness on hover */
		transition:
			opacity 0.15s,
			box-shadow 0.15s;
	}

	/* Hover/focus: the edge brightens and a wash of its color falls into the tab, like a lamp */
	.tab::before {
		content: "";
		position: absolute;
		inset: var(--frame) calc(var(--frame) * 1.5) 0;
		clip-path: polygon(calc(var(--slant) - 1px) 0, calc(100% - var(--slant) + 1px) 0, 100% 100%, 0 100%);
		background: linear-gradient(to bottom, color-mix(in srgb, var(--lit) 22%, transparent), transparent 90%);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.15s;
	}

	.tab:is(:hover, :focus-within)::before {
		opacity: 1;
	}

	.tab:is(:hover, :focus-within)::after {
		opacity: 1;
		box-shadow: 0 0 10px var(--lit);
	}

	/* The light anchored left and the ⓘ right, each exactly 32px from the tab's outer edge (the
	   tab's slant padding plus this), with the word centered between them */
	.status {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		justify-items: center;
		width: 100%;
		padding-inline: calc(32px - var(--slant));
		color: var(--lit);
		font-size: 0.65rem;
		white-space: nowrap;
	}

	/* Widely spaced letters; the negative margin drops the last letter's trailing space so the
	   word sits truly centered */
	.status-text {
		letter-spacing: 0.3em;
		margin-right: -0.3em;
	}

	.info {
		overflow: visible; /* the ring's soft edge would be clipped at the box */
	}

	.status:focus-visible {
		outline-offset: 3px;
	}

	.light {
		/* Whole-pixel size keeps the dot round */
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: currentColor;
		box-shadow: 0 0 3px currentColor; /* a tight glow, not a haze */
	}

	/* Hangs centered under the tab, pointing up at the status */
	.tip {
		position: absolute;
		top: calc(var(--tab-h) + 0.7rem);
		left: calc(var(--tab-w) / 2);
		translate: -50% 0;
		z-index: 2;
		width: min-content; /* as wide as its longest line */
		padding: 0.4rem 0.7rem 0.5rem; /* a touch more below: the capitals sit high in the line */
		text-align: center;
		line-height: 1.6;
		background: var(--bg);
		border: 1px solid var(--line);
		color: var(--text);
		letter-spacing: 0.1em;
		user-select: none;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition:
			opacity 0.15s,
			visibility 0.15s;
	}

	/* Pointer: a small outlined notch continuing the tooltip's border */
	.tip::before {
		content: "";
		position: absolute;
		top: -4px;
		left: calc(50% - 3.5px);
		width: 7px;
		height: 7px;
		background: var(--bg);
		border-top: 1px solid var(--line);
		border-left: 1px solid var(--line);
		rotate: 45deg;
	}

	.tab:is(:hover, :focus-within) + .tip {
		opacity: 1;
		visibility: visible;
	}

	/* Card contents, inside the outline. Text lines up with the inner edge of the screen's frame
	   (viewport margin + hull edge + bezel) */
	.card {
		--inset: calc(var(--space-3) + 1px + 0.55rem);
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: var(--frame);
	}

	/*
	 * Viewport, built like the About clip's: hull edge > bezel > screen,
	 * each clipped to the same cut-corner shape
	 */
	.viewport,
	.bezel,
	.screen {
		clip-path: polygon(
			var(--cut) 0,
			calc(100% - var(--cut)) 0,
			100% var(--cut),
			100% calc(100% - var(--cut)),
			calc(100% - var(--cut)) 100%,
			var(--cut) 100%,
			0 calc(100% - var(--cut)),
			0 var(--cut)
		);
	}

	.viewport {
		--cut: 1rem;
		margin: var(--space-3) var(--space-3) 0;
		padding: 1px;
		background: var(--border);
	}

	.bezel {
		--cut: calc(1rem - 0.41px);
		padding: 0.55rem;
		background: var(--bezel); /* shared with the About clip's bezel */
	}

	.screen {
		--cut: calc(1rem - 0.41px - 0.23rem);
		position: relative;
		margin: 0;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: var(--bg);
	}

	.screen img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: saturate(0.75) brightness(0.8) contrast(1.1); /* sits in the palette like a console feed */
		transition: filter 0.2s;
	}

	/* Glare across the glass */
	.screen::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(135deg, rgb(255 255 255 / 0.09), transparent 32%);
		pointer-events: none;
	}

	/* Faint scanlines and a dark rim */
	.screen::after {
		content: "";
		position: absolute;
		inset: 0;
		background: repeating-linear-gradient(transparent 0 2px, rgb(0 0 0 / 0.18) 2px 3px);
		box-shadow:
			inset 0 0 0 1px var(--border),
			inset 0 0 2.5rem rgb(0 0 0 / 0.65); /* glass edge and dark rim, as on the About clip */
		pointer-events: none;
	}

	.readout {
		position: absolute;
		right: 0.9rem; /* clear of the cut corner and the dark rim */
		bottom: 0.75rem;
		z-index: 2;
		padding: 0.1rem 0.4rem;
		background: rgb(11 14 20 / 0.7);
		color: var(--muted);
		font-size: 0.6rem;
	}

	/* No image yet: faint static bands and a dim crosshair */
	.no-signal {
		position: absolute;
		inset: 0;
		background:
			repeating-linear-gradient(transparent 0 7px, rgb(138 147 166 / 0.05) 7px 9px),
			radial-gradient(circle at 50% 50%, rgb(37 44 59 / 0.9), var(--bg) 70%);
	}

	.crosshair {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 2.4rem;
		height: 2.4rem;
		translate: -50% -50%;
		border: 1px solid var(--border);
		border-radius: 50%;
		background:
			linear-gradient(var(--muted), var(--muted)) 50% 0 / 1px 30% no-repeat,
			linear-gradient(var(--muted), var(--muted)) 50% 100% / 1px 30% no-repeat,
			linear-gradient(var(--muted), var(--muted)) 0 50% / 30% 1px no-repeat,
			linear-gradient(var(--muted), var(--muted)) 100% 50% / 30% 1px no-repeat;
		opacity: 0.6;
	}

	/* Separator above the tags: a plain hairline, in the frame's resting color (it doesn't brighten) */
	.separator {
		margin: 0 var(--inset);
		border: 0;
		height: 1px;
		background: #2e3649;
	}

	.text {
		display: grid;
		align-content: start;
		gap: 0.75rem;
		flex-grow: 1; /* keeps the tags at the bottom, level across cards */
		padding: var(--space-3) var(--inset) 1.25rem;
	}

	h3 {
		font-size: 1.125rem;
		letter-spacing: var(--tracking-title);
		text-transform: uppercase;
	}

	/* The arrow, in proportion to the title, is pinned to the right edge of the text, so it lines up
	   across cards and never wraps a title */
	h3 a {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--space-2);
		color: var(--text);
	}

	h3 a :global(svg) {
		flex-shrink: 0;
	}

	/* The whole card is the link: the title link's box stretches over it (above the screen's
	   readout). The status tab sits outside the card, so its tooltip keeps working. */
	h3 a::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 3;
	}

	/* Keyboard focus rings the whole card, not just the title */
	h3 a:focus-visible {
		outline: none;
	}

	.card:has(h3 a:focus-visible) {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	.summary {
		color: var(--muted);
		font-size: 0.875rem;
		line-height: 1.75;
		min-height: 2lh; /* room for two lines, so a one-line summary doesn't shift the cards */
		text-wrap: pretty; /* no short lines or lone last word in the narrow card */
	}

	/* The shared tag list hides a leading "·" by shifting left and clipping; keep the card's padding */
	/* Tighter than the shared tags (narrower separators and tracking) so two long tags share a line */
	.stack {
		--sep: 1.75em;
		letter-spacing: 0.14em;
		margin-left: calc(var(--inset) - var(--sep));
		padding: 1.25rem var(--inset) var(--space-3) 0;
	}

	/*
	 * Hover (or keyboard focus) anywhere on the card: the frame brightens slightly and the screen
	 * brightens a little, like a monitor waking up. The title doesn't underline; the whole card is
	 * the link.
	 */
	.panel {
		transition: --line 0.15s;
	}

	.panel:has(.card:hover, h3 a:focus-visible) {
		--line: #3f4960;
	}

	.panel:has(.card:hover, h3 a:focus-visible) .screen img {
		filter: saturate(0.85) brightness(0.9) contrast(1.09);
	}

	h3 a:hover {
		text-decoration: none;
	}
</style>

<style is:global>
	/* Registered so the frame color can fade on hover (plain custom properties switch instantly) */
	@property --line {
		syntax: "<color>";
		inherits: true;
		initial-value: #2e3649;
	}
</style>
