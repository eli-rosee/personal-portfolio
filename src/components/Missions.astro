---
import { getCollection } from "astro:content";
import MissionCard from "./MissionCard.astro";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
	(a, b) => a.data.number - b.data.number,
);
---

<section id="missions" class="section" aria-labelledby="missions-heading">
	<h2 id="missions-heading" class="section-title">// Missions</h2>
	<div class="grid">
		{projects.map((project) => <MissionCard project={project} />)}
	</div>
</section>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
		gap: var(--space-3);
	}
</style>
