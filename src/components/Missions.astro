---
import { getCollection } from "astro:content";
import MissionCard from "./MissionCard.astro";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
	(a, b) => a.data.number - b.data.number,
);
---

<section id="missions" aria-labelledby="missions-heading">
	<h2 id="missions-heading" class="label">// Missions</h2>
	<div class="grid">
		{projects.map((project) => <MissionCard project={project} />)}
	</div>
</section>

<style>
	section {
		max-width: var(--page-max);
		margin: 0 auto;
		padding: var(--space-8) var(--gutter) var(--space-12);
	}

	h2 {
		padding-bottom: var(--space-2);
		margin-bottom: var(--space-4);
		border-bottom: var(--border-width) solid var(--border);
		font-size: var(--text-sm);
		font-weight: 700;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
		gap: var(--space-3);
	}
</style>
