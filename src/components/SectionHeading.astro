---
// A section heading in Mission Control DCU. The font's license only allows images of it, so the
// word is a PNG from scripts/render-art.py; its alt text is the heading's text for screen
// readers and search. Renaming a section means re-running that script.
import { Image } from "astro:assets";
import projects from "../assets/brand/headings/projects.png";
import about from "../assets/brand/headings/about.png";
import telemetry from "../assets/brand/headings/telemetry.png";
import media from "../assets/brand/headings/media.png";
import nextProject from "../assets/brand/headings/next-project.png";

interface Props {
	id: string;
	text: "Projects" | "About" | "Telemetry" | "Media" | "Next project";
}

const { id, text } = Astro.props;
const art = { Projects: projects, About: about, Telemetry: telemetry, Media: media, "Next project": nextProject }[text];
---

<h2 id={id} class="section-title">
	{/* Projects is on screen at load; the others load as they come near */}
	<Image src={art} alt={text} height={21} densities={[1, 2]} loading={text === "Projects" ? "eager" : "lazy"} />
</h2>
