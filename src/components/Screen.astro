---
/*
 * The console screen: hull edge > bezel > rim > glass, each clipped to the same bevelled shape, holding
 * whatever is slotted in. Used inside the console card (ConsoleCard) and on its own (project figures,
 * the theater).
 *
 * Sizes come from CSS variables, inherited from a wrapper or set through `style`:
 *   --screen-cut   the bevelled corners          --bezel-pad   the bezel's width
 *   --grade        the color grade on images and video ("none" for none)
 *   --screen-tint  an optional tint in the glass
 * `plain` shows the content as it is: no grade, glare, scanlines or dark rim (the 1px glass edge stays).
 */
interface Props {
	plain?: boolean;
	class?: string;
	style?: string;
}

const { plain = false, class: className, style } = Astro.props;
---

<div class:list={["viewport", { plain }, className]} style={style}>
	<div class="bezel">
		<div class="rim">
			<div class="screen">
				<slot />
			</div>
		</div>
	</div>
</div>

<style>
	/*
	 * Each layer is cut to the bevelled shape at its corners only: the clip's straight sides lie outside
	 * the box (its diagonals are the same lines, extended), so the box's own edges, which the browser
	 * snaps to whole pixels, make the sides. A clip along the sides would land between pixels at most
	 * zoom levels and fade the 1px lines there. A layer inset by p needs a cut about 0.41p smaller to
	 * keep the diagonal edges even.
	 */
	.viewport,
	.bezel,
	.rim,
	.screen {
		--o: 9px; /* how far past the box the straight sides of the clip lie */
		clip-path: polygon(
			calc(var(--c) + var(--o)) calc(-1 * var(--o)),
			calc(100% - var(--c) - var(--o)) calc(-1 * var(--o)),
			calc(100% + var(--o)) calc(var(--c) + var(--o)),
			calc(100% + var(--o)) calc(100% - var(--c) - var(--o)),
			calc(100% - var(--c) - var(--o)) calc(100% + var(--o)),
			calc(var(--c) + var(--o)) calc(100% + var(--o)),
			calc(-1 * var(--o)) calc(100% - var(--c) - var(--o)),
			calc(-1 * var(--o)) calc(var(--c) + var(--o))
		);
	}

	.viewport {
		--c: var(--screen-cut, 1rem);
		padding: 1px;
		background: var(--border);
	}

	.bezel {
		--c: calc(var(--screen-cut, 1rem) - 0.41px);
		padding: var(--bezel-pad, 0.55rem);
		background: var(--bezel);
	}

	/* The glass's 1px edge is the rim showing around the glass, built like the hull edge around the
	   bezel: one layer 1px bigger than the next, both cut the same way, so every side and every bevel
	   is drawn by the same two edges at any zoom (a border plus separate bevel pieces drew the corners
	   unevenly at some zoom levels) */
	.rim {
		--c: calc(var(--screen-cut, 1rem) - 0.41px - 0.41 * var(--bezel-pad, 0.55rem));
		padding: 1px;
		background: var(--frame-line-lit); /* bright enough to read on dark footage */
	}

	.screen {
		--c: calc(var(--screen-cut, 1rem) - 0.82px - 0.41 * var(--bezel-pad, 0.55rem));
		position: relative;
		overflow: hidden;
		background: var(--bg);
	}

	/* The glass, over the slotted contents: glare across the top, faint scanlines, an optional
	   tint (--screen-tint) and a dark rim. Overlays that must stay crisp (labels, buttons) sit
	   above it with z-index 2. */
	.screen::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
		background:
			linear-gradient(135deg, rgb(255 255 255 / 0.09), transparent 32%),
			repeating-linear-gradient(transparent 0 2px, rgb(0 0 0 / 0.18) 2px 3px),
			var(--screen-tint, transparent);
		box-shadow: inset 0 0 2.5rem rgb(0 0 0 / 0.65);
		pointer-events: none;
	}

	/* Footage and images, graded to sit in the palette like a console feed. A card sets
	   --screen-grade to its lit grade on hover. */
	.screen :global(:is(img, video)) {
		filter: var(--screen-grade, var(--grade, saturate(0.75) brightness(0.8) contrast(1.1)));
		transition: filter 0.2s;
	}

	.plain {
		--screen-grade: none;
	}

	.plain .screen::after {
		display: none;
	}
</style>
