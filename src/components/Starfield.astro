---
// Faint stars fixed behind the whole page, drifting slowly to the left (src/scripts/sky.ts).
// Decorative only: without JavaScript or canvas support the sky is just empty.
// With reduced motion the stars are drawn once and never move.
// Kept cheap for phones: it's drawn in a worker where the browser allows (OffscreenCanvas), so the
// page's own thread is free for scrolling and animations (Firefox excepted: there the worker's canvas
// cost about twice the CPU of drawing on the page, so it draws on the page); it pauses while the page scrolls, during a
// project page's rocket flight (html.in-flight) and in a hidden tab, redraws 15 times a second, and renders at no more than 2x pixel density.
---

<canvas class="starfield" aria-hidden="true"></canvas>

<script>
	import { sky, type Sky } from "../scripts/sky";
	import SkyWorker from "../scripts/sky-worker?worker";

	const canvas = document.querySelector<HTMLCanvasElement>(".starfield");
	const SCROLL_REST_MS = 200; // resume this long after the last scroll event

	// The sky, in a worker (it gets the canvas) or on the page (it gets the canvas's context). Firefox draws
	// a worker's canvas at about twice the cost of the page's (measured), so it keeps it on the page.
	const offthread = "transferControlToOffscreen" in HTMLCanvasElement.prototype && typeof Worker === "function" && !/\bFirefox\//.test(navigator.userAgent);
	const open = (canvas: HTMLCanvasElement): Sky | undefined => {
		const color = getComputedStyle(canvas).getPropertyValue("--text");
		if (offthread) {
			const offscreen = canvas.transferControlToOffscreen();
			const worker = new SkyWorker();
			worker.postMessage({ canvas: offscreen, color }, [offscreen]);
			return {
				size: (w, h, dpr) => worker.postMessage({ size: [w, h, dpr] }),
				run: (on) => worker.postMessage({ run: on }),
			};
		}
		const ctx = canvas.getContext("2d");
		return ctx ? sky(ctx, color) : undefined;
	};

	const stars = canvas && open(canvas);
	if (!canvas || !stars) {
		canvas?.remove();
	} else {
		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		let scrolling = false;
		let scrollTimer = 0;
		// It drifts unless something says not to
		const html = document.documentElement;
		let running: boolean | undefined;
		const update = () => {
			const on = !reducedMotion.matches && !scrolling && !document.hidden && !html.classList.contains("in-flight");
			if (on !== running) stars.run((running = on));
		};

		// Nothing redraws behind the page while it's scrolling
		const onScroll = () => {
			if (!scrolling) {
				scrolling = true;
				update();
			}
			clearTimeout(scrollTimer);
			scrollTimer = window.setTimeout(() => {
				scrolling = false;
				update();
			}, SCROLL_REST_MS);
		};

		new ResizeObserver(() => stars.size(canvas.clientWidth, canvas.clientHeight, Math.min(window.devicePixelRatio || 1, 2))).observe(canvas);
		reducedMotion.addEventListener("change", update);
		document.addEventListener("visibilitychange", update);
		new MutationObserver(update).observe(html, { attributeFilter: ["class"] });
		addEventListener("scroll", onScroll, { passive: true });
		update();
	}
</script>

<style>
	.starfield {
		/* No negative z-index: Firefox on Android paints the page background over it.
		   Instead the canvas comes first in the page, and the sections after it are
		   positioned (below), so they paint on top of it. */
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100vh;
		height: 100lvh; /* phones: doesn't resize when the address bar shows or hides */
		pointer-events: none;
	}

	:global(body > :is(header, main, footer)) {
		position: relative;
	}
</style>
