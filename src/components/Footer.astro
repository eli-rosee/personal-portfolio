---
// Telemetry: three live readouts (ISS position, Voyager 1's distance, server uptime), then
// "Powered by Astro" with my email beside it (and a copy button). Each readout stays hidden until it has real data, so a failure (or no
// JavaScript) just leaves it out; with none, the whole section hides.
import SectionHeading from "./SectionHeading.astro";
import Readout from "./Readout.astro";

// The project pages leave out the telemetry; just the credit line
const { telemetry = true } = Astro.props as { telemetry?: boolean };
import { site } from "../content/site";
---

<footer>
	<div class="inner">
		{telemetry && <section class="telemetry" aria-labelledby="telemetry-heading">
			<SectionHeading id="telemetry-heading" text="Telemetry" />
			<dl class="grid">
				<Readout label="ISS position" data-iss hidden valueAttrs={{ "data-iss-coords": "" }} noteAttrs={{ "data-iss-place": "" }} />
				<Readout label={"Voyager\u00a01"} data-voyager hidden note="from the Sun"><Fragment slot="value"><span data-voyager-total></span> km</Fragment></Readout>
				<Readout label="Uptime" id="uptime" data-uptime hidden valueAttrs={{ "data-uptime-value": "" }} note="self-hosted at home" />
			</dl>
		</section>}

		<p class="credit label">
			<span>Powered by <a href="https://astro.build" target="_blank" rel="noopener">Astr<span class="last">o</span></a></span>
			<span class="dot" aria-hidden="true">·</span>
			<a class="email" href={`mailto:${site.email}`}>{site.email}</a>
			<button class="copy" type="button" data-copy={site.email}><span data-copy-label>Copy</span></button>
		</p>
	</div>
</footer>

<script>
	import { renderLive, replayAnimation, setText } from "../scripts/live";

	// Copy the email address; the button says so for two seconds
	const copy = document.querySelector<HTMLButtonElement>("footer [data-copy]");
	const copyLabel = copy?.querySelector<HTMLElement>("[data-copy-label]");
	if (copy && copyLabel) {
		let reset = 0;
		copy.addEventListener("click", async () => {
			try {
				await navigator.clipboard.writeText(copy.dataset.copy!);
			} catch {
				return; // no clipboard access (insecure page, or refused): the mailto link still works
			}
			copyLabel.textContent = "Copied";
			copy.classList.add("copied");
			clearTimeout(reset);
			reset = window.setTimeout(() => {
				copyLabel.textContent = "Copy";
				copy.classList.remove("copied");
			}, 2000);
		});
	}

	const footer = document.querySelector("footer")!;

	/*
	 * Uptime: how long the server has been up, from /assets/status.json ({ "started": "<ISO date>" }),
	 * which the container writes when it starts. Missing or malformed: the readout stays hidden.
	 */
	const startUptime = async () => {
		const cell = document.querySelector<HTMLElement>("[data-uptime]");
		const value = document.querySelector("[data-uptime-value]");
		if (!cell || !value) return;

		const format = (ms: number) => {
			const hours = Math.floor(ms / 3_600_000);
			if (hours >= 24) return `${Math.floor(hours / 24)}d ${hours % 24}h`;
			if (hours >= 1) return `${hours}h`;
			return `${Math.max(1, Math.floor(ms / 60_000))}m`;
		};

		// "self-hosted" in the About text links here: once the readout is in view, it flashes amber.
		// Without a readout, the link goes to the telemetry instead.
		document.querySelectorAll('a[href="#uptime"]').forEach((link) =>
			link.addEventListener("click", (event) => {
				if (cell.hidden) {
					event.preventDefault();
					footer.scrollIntoView();
					return;
				}
				const observer = new IntersectionObserver(
					([entry]) => {
						if (!entry.isIntersecting) return;
						observer.disconnect();
						replayAnimation(cell, "pinged");
					},
					{ threshold: 1 },
				);
				observer.observe(cell);
			}),
		);

		try {
			const response = await fetch("/assets/status.json", { cache: "no-store" });
			if (!response.ok) return;
			const { started } = (await response.json()) as { started: string };
			const startedAt = Date.parse(started);
			if (!(Date.now() >= startedAt)) return; // unparseable, or in the future

			// Recount every minute (the finest unit shown), and right away when the tab comes back,
			// since background tabs and sleeping laptops pause timers
			const render = () => setText(value, format(Date.now() - startedAt));
			render();
			setInterval(render, 60_000);
			document.addEventListener("visibilitychange", () => document.hidden || render());
			cell.hidden = false;
		} catch {
			// Unreachable or not JSON: stays hidden
		}
	};

	/*
	 * Voyager 1: distance from the Sun, extrapolated from a JPL Horizons reference point. Its speed
	 * away from the Sun is nearly constant, so a straight line stays accurate to well under 0.001%
	 * for years. To refresh: Horizons, COMMAND='-31', QUANTITIES='19'.
	 */
	const startVoyager = () => {
		const REFERENCE_TIME = Date.UTC(2026, 8, 24); // 2026-09-24 00:00 UTC
		const REFERENCE_KM = 25_706_772_400; // distance from the Sun at REFERENCE_TIME
		const KM_PER_SECOND = 16.8817;

		const cell = document.querySelector<HTMLElement>("[data-voyager]");
		const total = document.querySelector("[data-voyager-total]");
		if (!cell || !total) return;

		const format = new Intl.NumberFormat("en-US", { maximumFractionDigits: 0 });
		// The last digits roll like an odometer: Voyager covers ~17 km a second
		renderLive(() => {
			const seconds = (Date.now() - REFERENCE_TIME) / 1000;
			setText(total, format.format(REFERENCE_KM + seconds * KM_PER_SECOND));
		}, footer);
		cell.hidden = false;
	};

	/*
	 * ISS position, from wheretheiss.at. Each poll asks where the ISS is now and where it will be
	 * 10 seconds from now; between polls the display glides from one to the other, so the
	 * coordinates tick continuously. The place below them is the country it's over (from the
	 * API) or, over water, a rough ocean guess.
	 */
	const startIss = () => {
		const API = "https://api.wheretheiss.at/v1";
		const POLL_MS = 5000; // the API allows 350 requests per 5 minutes; this uses 120
		const LOOKAHEAD_S = 10;

		type Position = { latitude: number; longitude: number; timestamp: number };

		const cell = document.querySelector<HTMLElement>("[data-iss]");
		const coords = document.querySelector("[data-iss-coords]");
		const place = document.querySelector("[data-iss-place]");
		if (!cell || !coords || !place) return;

		const countryNames = new Intl.DisplayNames(["en"], { type: "region" });
		// Countries that read as "over the ___"
		const takesThe = new Set(["US", "GB", "NL", "PH", "AE", "CZ", "DO", "CD", "CG", "CF", "BS", "GM"]);

		const getJson = async <T,>(url: string): Promise<T> => {
			const response = await fetch(url);
			if (!response.ok) throw new Error(`${response.status} ${url}`);
			return response.json();
		};

		// Rough ocean boundaries, good enough to say which ocean the ISS is over. (Its orbit stays
		// between 51.6°N and 51.6°S, so no Arctic or Southern Ocean.)
		const oceanAt = (lat: number, lon: number) => {
			const half = lat >= 0 ? "North" : "South";
			if (lat > 30 && lat < 46 && lon > -6 && lon < 36) return "the Mediterranean";
			if (lon > 20 && lon < 147 && lat < 25 && !(lon > 100 && lat > -10)) return "the Indian Ocean";
			if (lon > -70 && lon <= 20) return `the ${half} Atlantic`;
			if (lat > 8 && lon > -100 && lon <= -70) return "the North Atlantic"; // Caribbean, Gulf
			return `the ${half} Pacific`;
		};

		const placeAt = async ({ latitude, longitude }: Position) => {
			try {
				const { country_code } = await getJson<{ country_code: string }>(
					`${API}/coordinates/${latitude},${longitude}`,
				);
				const name = /^[A-Z]{2}$/.test(country_code) && countryNames.of(country_code);
				if (name) return takesThe.has(country_code) ? `the ${name}` : name;
			} catch {
				// Lookup failed: fall back to the ocean guess
			}
			return oceanAt(latitude, longitude);
		};

		// Where the ISS is at `ms`, on the line between the two known positions. Longitude wraps
		// at ±180°, so the step between them is taken the short way round.
		let from: Position | undefined;
		let to: Position | undefined;
		const positionAt = (ms: number) => {
			if (!from || !to) return;
			const t = (ms / 1000 - from.timestamp) / (to.timestamp - from.timestamp);
			const dLon = ((to.longitude - from.longitude + 540) % 360) - 180;
			const lon = ((from.longitude + dLon * t + 540) % 360) - 180;
			return { lat: from.latitude + (to.latitude - from.latitude) * t, lon };
		};

		const render = () => {
			const position = positionAt(Date.now());
			if (!position) return;
			const { lat, lon } = position;
			setText(
				coords,
				`${Math.abs(lat).toFixed(2)}°${lat >= 0 ? "N" : "S"} ${Math.abs(lon).toFixed(2)}°${lon >= 0 ? "E" : "W"}`,
			);
		};

		// A new place name flashes briefly so the change gets noticed
		const setPlace = (name: string) => {
			const text = `over ${name}`;
			if (place.textContent === text) return;
			const isFirst = place.textContent === "";
			place.textContent = text;
			if (!isFirst) replayAnimation(place, "changed");
		};

		let failures = 0;
		let timer: number | undefined;
		let polling = false;

		const poll = async () => {
			polling = true;
			try {
				const now = Math.floor(Date.now() / 1000);
				[from, to] = await getJson<Position[]>(
					`${API}/satellites/25544/positions?timestamps=${now},${now + LOOKAHEAD_S}`,
				);
				render();
				setPlace(await placeAt(from));
				cell.hidden = false;
				failures = 0;
			} catch {
				// One miss keeps gliding on the last reading; repeated misses hide the readout
				if (++failures >= 3) cell.hidden = true;
			}
			polling = false;
			if (!document.hidden) timer = window.setTimeout(poll, POLL_MS);
		};

		poll();
		// No polling in background tabs; resume when the tab is visible again
		document.addEventListener("visibilitychange", () => {
			clearTimeout(timer);
			if (!document.hidden && !polling) poll();
		});
		renderLive(render, footer);
	};

	startUptime();
	startVoyager();
	startIss();
</script>

<style>
	/* The same gap as between the page's sections (the last section's bottom padding plus this seam) */
	footer {
		margin-top: var(--section-seam);
	}

	.inner {
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 0 var(--gutter) var(--space-6);
	}

	/* Hide the heading too when no readout has data */
	.telemetry:not(:has(:global(.cell:not([hidden])))) {
		display: none;
	}

	/* All readouts in one row where they fit, otherwise stacked in one column (no 2×2) */
	.grid {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		margin: 0;
	}

	@media (min-width: 64rem) {
		.grid {
			flex-direction: row;
			justify-content: space-between; /* each readout as wide as its content, leftover space between */
			/* Only a minimum: on wide screens the gutters grow and the content gets narrower,
			   and a bigger gap pushed the last readout past the right edge */
			gap: var(--space-1);
		}
	}

	/* The place name wraps under the coordinates instead of widening the readout
	   ("over the Democratic Republic of the Congo" would push the row off the edge) */
	.grid :global([data-iss-place]) {
		contain: inline-size;
		white-space: normal;
	}

	/* Well clear of the telemetry, centered */
	/* One centered line: the credit, then the address and its copy button (wraps on narrow screens) */
	.credit {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		row-gap: var(--space-1);
		margin-top: clamp(var(--space-6), 8vw, var(--space-12));
		text-align: center;
	}

	.dot {
		margin: 0 1.6rem;
	}

	/* Addresses in Plex Mono: Space Mono's @ reads as an "a" */
	.credit .email {
		font-family: var(--font-body);
		font-size: 0.8rem;
		letter-spacing: 0;
		text-transform: none;
		text-decoration: none;
	}

	.credit .email {
		color: var(--muted);
	}

	.credit .email:hover {
		color: var(--text);
	}

	/* [ Copy ]: the About links' amber console brackets */
	.copy {
		all: unset;
		margin-left: 1.15rem;
		color: var(--text);
		cursor: pointer;
		transition: color 0.15s;
	}

	.copy::before {
		content: "[";
		margin-right: 0.3em;
		color: var(--accent);
	}

	.copy::after {
		content: "]";
		margin-left: 0.15em;
		color: var(--accent);
	}

	.copy:hover {
		color: #fff;
	}

	.copy:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	.copy.copied {
		color: var(--status);
	}

	.credit a {
		color: var(--text);
		text-decoration: underline;
		text-decoration-color: var(--muted);
		text-underline-offset: 0.3em;
	}

	.credit a:hover {
		text-decoration-color: var(--accent);
	}

	/* The wide tracking trails the last letter, so the underline overshot it: no tracking after the
	   last letter (the dot's margin keeps the gap) */
	.credit .last {
		letter-spacing: 0;
	}
</style>
