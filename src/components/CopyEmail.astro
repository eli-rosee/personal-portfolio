---
// Email button: copies the address on desktop. On phones, or without JavaScript, it opens
// the mail app. Pass `class` to style it as a button; the parent's scoped styles apply
// because the rest of the props (including Astro's scope attribute) are spread onto it.
import { site } from "../data/site";

interface Props {
	label: string;
	copiedLabel?: string;
	class?: string;
}

const { label, copiedLabel = "Copied", class: className, ...rest } = Astro.props;
---

<a class:list={["copy-email", className]} href={`mailto:${site.email}`} data-email={site.email} {...rest}>
	<span class="copy-label">{label}</span>
	<span class="copy-label copied" aria-hidden="true">{copiedLabel}</span>
</a>
<p class="copy-status sr-only" role="status" aria-live="polite"></p>

<script>
	document.querySelectorAll<HTMLAnchorElement>(".copy-email").forEach((button) => {
		const status = button.nextElementSibling as HTMLElement | null;
		let resetTimer: number | undefined;

		button.addEventListener("click", async (event) => {
			const email = button.dataset.email;
			// Touch devices (no hover) keep the normal mailto link and open the mail app
			const isTouch = window.matchMedia("(hover: none)").matches;
			if (!email || !navigator.clipboard || isTouch) return;

			event.preventDefault();
			try {
				await navigator.clipboard.writeText(email);
			} catch {
				window.location.href = button.href; // copy blocked: fall back to mailto
				return;
			}

			button.classList.add("is-copied");
			if (status) status.textContent = `Copied ${email} to clipboard`;
			clearTimeout(resetTimer);
			resetTimer = window.setTimeout(() => {
				button.classList.remove("is-copied");
				if (status) status.textContent = "";
			}, 2000);
		});
	});
</script>

<style>
	/* Both labels share one grid cell so the button keeps its width when swapping.
	   `a.` outranks the parent's `.button { display }` whatever order the CSS loads in. */
	a.copy-email {
		display: inline-grid;
	}

	.copy-label {
		grid-area: 1 / 1;
		text-align: center;
	}

	.copy-label.copied,
	.copy-email.is-copied .copy-label:not(.copied) {
		visibility: hidden;
	}

	a.copy-email.is-copied {
		border-color: var(--status);
	}

	.copy-email.is-copied .copied {
		visibility: visible;
		color: var(--status);
	}
</style>
