# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# licensed design assets (desktop license: must not be served or redistributed)
design/fonts/

# editor settings
.vscode/

# files copied to the server by hand and never committed: the resume(s), the About clip and its
# poster. Everything in public/files/ is served at /files/.
public/files/

# written by the server (scripts/rebuild.sh); the local copy is a fake for development
public/assets/status.json

# project videos stay out of the repo: they live in each project's assets/ folder locally and are
# copied to the server by hand (see PLAN.md)
src/content/projects/*/assets/**/*.mp4
src/content/projects/*/assets/**/*.webm
src/content/projects/*/assets/**/*.mov
